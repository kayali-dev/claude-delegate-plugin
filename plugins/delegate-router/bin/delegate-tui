const USAGE = `Usage: delegate-tui [--job <id>]
       delegate-tui --serve [--port <number>]
       delegate-tui --connect <url> [--token-file <path>] [--connect <url> ...] [--include-local] [--job <id>]
       delegate-tui --analyze <diagnostic-directory>

Live ANSI dashboard for Delegate Router's local or read-only remote managed-job store.

Options:
  -h, --help          Show this help without entering the alternate screen
  --job <id>          Open directly in that managed job's detail
  --serve             Export the local store read-only on 127.0.0.1
  --port <number>     Serve port (default 4263)
  --connect <url>     Connect to a read-only host (repeatable)
  --token-file <path> Pair a bearer-token file with --connect by order (repeatable)
  --include-local     Merge the local store with connected remote hosts
  --analyze <path>    Replay DELEGATE_TUI_DIAG logs without requiring a TTY

The TUI requires an interactive macOS or Linux terminal. It honors
DELEGATE_STATE_FILE and the ordinary delegate-router provider configuration.
DELEGATE_CONNECT_TOKEN supplies the client token when --token-file is omitted.
DELEGATE_TUI_THEME=dark|light|dark-daltonized|light-daltonized|dark-ansi|light-ansi selects the palette.
DELEGATE_TUI_WIDTH_PROBE=off|verbose controls terminal width probing.
DELEGATE_TUI_ASCII=1 forces the conservative ASCII glyph tier.
DELEGATE_TUI_DIAG=<path> records replayable terminal bytes, intended frames, and input-to-paint timings.
DELEGATE_TUI_DIAG_WATCH=off disables local fs.watch only during a diagnostic recording.`;

const args = process.argv.slice(2);
if (args.includes('--help') || args.includes('-h')) {
  console.log(USAGE);
  process.exit(0);
}

function argumentError(message) {
  console.error(`delegate-tui: ${message}\n${USAGE}`);
  process.exit(2);
}

const cli = { initialJobId: null, serve: false, port: 4263, connects: [], tokenFiles: [], includeLocal: false, analyze: null };
for (let index = 0; index < args.length; index += 1) {
  const arg = args[index];
  if (arg === '--serve') cli.serve = true;
  else if (arg === '--job') {
    const value = args[++index];
    if (!value) argumentError('--job requires exactly one job id');
    cli.initialJobId = value;
  } else if (arg === '--port') {
    const value = args[++index];
    if (!value || !/^\d+$/.test(value)) argumentError('--port requires an integer');
    cli.port = Number(value);
    if (!Number.isInteger(cli.port) || cli.port < 0 || cli.port > 65535) argumentError('--port must be between 0 and 65535');
  } else if (arg === '--connect') {
    const value = args[++index];
    if (!value) argumentError('--connect requires a URL');
    cli.connects.push(value);
  } else if (arg === '--token-file') {
    const value = args[++index];
    if (!value) argumentError('--token-file requires a path');
    cli.tokenFiles.push(value);
  } else if (arg === '--include-local') {
    cli.includeLocal = true;
  } else if (arg === '--analyze') {
    const value = args[++index];
    if (!value) argumentError('--analyze requires a diagnostic directory');
    cli.analyze = value;
  } else argumentError(`unknown option: ${arg}`);
}
if (cli.serve && cli.connects.length) argumentError('--serve and --connect are mutually exclusive');
if (cli.serve && cli.initialJobId) argumentError('--job cannot be combined with --serve');
if (!cli.serve && args.includes('--port')) argumentError('--port requires --serve');
if (!cli.connects.length && cli.tokenFiles.length) argumentError('--token-file requires --connect');
if (cli.analyze && (cli.serve || cli.connects.length || cli.includeLocal || cli.initialJobId || args.includes('--port') || cli.tokenFiles.length)) argumentError('--analyze cannot be combined with interactive or server options');

if (cli.analyze) {
  try {
    console.log(analyzeTuiDiagnostics(cli.analyze));
    process.exit(0);
  } catch (error) {
    console.error(`delegate-tui: diagnostic analysis failed: ${error.message}`);
    process.exit(1);
  }
}

if (cli.serve) {
  try {
    const { startDelegateServe } = await import('./lib/serve.mjs');
    const running = await startDelegateServe({ port: cli.port });
    const url = `http://${running.host}:${running.port}`;
    if (running.created) {
      console.error(`delegate-tui: remote bearer token (shown once): ${running.token}`);
      console.error(`delegate-tui: connect with: delegate-tui --connect ${url} --token-file ${running.tokenFile}`);
      console.error(`delegate-tui: SSH tunnel: ssh -L ${running.port}:127.0.0.1:${running.port} host`);
    } else if (running.source === 'file') {
      console.error(`delegate-tui: bearer token file: ${running.tokenFile}`);
    } else {
      console.error('delegate-tui: bearer token supplied by DELEGATE_SERVE_TOKEN');
    }
    console.error(`delegate-tui: read-only server listening on ${url}`);
    let stopping = false;
    await new Promise((resolve) => {
      const stop = async (signal) => {
        if (stopping) return;
        stopping = true;
        console.error(`delegate-tui: ${signal}; shutting down`);
        await running.close();
        resolve();
      };
      process.once('SIGINT', () => void stop('SIGINT'));
      process.once('SIGTERM', () => void stop('SIGTERM'));
    });
    process.exit(0);
  } catch (error) {
    console.error(`delegate-tui: ${error.message}`);
    process.exit(1);
  }
}

const initialJobId = cli.initialJobId;
let remoteTargets = [];
try {
  remoteTargets = resolveRemoteTargets({ connects: cli.connects, tokenFiles: cli.tokenFiles, env: process.env });
} catch (error) {
  console.error(`delegate-tui: cannot load remote configuration: ${error.message}`);
  process.exit(1);
}
if (cli.includeLocal && !remoteTargets.length) argumentError('--include-local requires at least one --connect or remotes.json entry');
if (!remoteTargets.length || cli.includeLocal) {
  try { maybePruneJobs(); } catch {}
}
if (initialJobId && !/^[a-zA-Z0-9_-]+$/.test(initialJobId)) {
  console.error(`delegate-tui: invalid job id: ${initialJobId}`);
  process.exit(1);
}
if (initialJobId && !remoteTargets.length) {
  try {
    if (!loadJob(initialJobId)) {
      console.error(`delegate-tui: job not found: ${initialJobId}`);
      process.exit(1);
    }
  } catch (error) {
    console.error(`delegate-tui: ${normalizeBrokerError(error, { defaultCode: 'INTERNAL' }).message}`);
    process.exit(1);
  }
}
if (!process.stdout.isTTY) {
  console.error('delegate-tui: stdout is not a TTY; run it from an interactive terminal');
  process.exit(2);
}
if (!process.stdin.isTTY) {
  console.error('delegate-tui: stdin is not a TTY; interactive input is required');
  process.exit(2);
}
if (process.platform === 'win32') {
  console.error('delegate-tui: v1 supports macOS and Linux terminals only');
  process.exit(2);
}

const NUDGE_PROMPT = 'Your final message described the deliverable instead of containing it. Paste the complete findings inline now.';
const TERMINAL = new Set(['completed', 'failed', 'cancelled']);
const DIFF_WINDOW = 12000;
const CHOICE_FIELDS = new Set(['intentSource', 'profile', 'provider', 'mode', 'effort']);
const TUI_PACKAGE_VERSION = (() => {
  try {
    const manifest = JSON.parse(fs.readFileSync(new URL('../package.json', import.meta.url), 'utf8'));
    return typeof manifest.version === 'string' && manifest.version.trim() ? manifest.version.trim() : null;
  } catch {
    return null;
  }
})();

const preferences = loadTuiPreferences();
const widthIdentity = terminalWidthIdentity(process.env);
const widthProbeCache = { ...(preferences.widthProbeCache || {}) };
const cachedCandidate = widthProbeCache[widthIdentity] || null;
// Probe families grow as chrome evolves. An older partial cache must not
// silently gate newly added elegant glyphs forever; refresh it once instead.
const cachedWidths = cachedCandidate?.widths && WIDTH_PROBE_GRAPHEMES.every((glyph) => Object.hasOwn(cachedCandidate.widths, glyph))
  ? cachedCandidate : null;
if (cachedWidths?.widths) setGraphemeWidthOverrides(cachedWidths.widths);
configureGlyphs({ env: process.env, widths: cachedWidths?.widths || {} });
setUiTheme(preferences.theme);
let diagnosticRecorder = null;
if (process.env.DELEGATE_TUI_DIAG) {
  try { diagnosticRecorder = new TuiFlightRecorder(process.env.DELEGATE_TUI_DIAG); }
  catch (error) {
    console.error(`delegate-tui: cannot start diagnostic recorder: ${error.message}`);
    process.exit(1);
  }
}
const outputCapture = new TerminalOutputCapture({
  limit: 100,
  onEntry(entry) {
    addStatusHistory(entry.text, entry.stream === 'stderr' ? 'error' : 'info', entry.stream);
  }
});
const screen = new Screen({ outputCapture, diagnostics: diagnosticRecorder });
const diagnosticWatch = !diagnosticRecorder || String(process.env.DELEGATE_TUI_DIAG_WATCH || '').toLowerCase() !== 'off';
const source = !remoteTargets.length
  ? new DelegateDataSource({ diagnostics: diagnosticRecorder, watch: diagnosticWatch }).start()
  : remoteTargets.length === 1 && !cli.includeLocal
    ? new RemoteDatasource({ baseUrl: remoteTargets[0].url, token: remoteTargets[0].token, label: remoteTargets[0].label }).start()
    : composeDatasources([
      ...(cli.includeLocal ? [{ source: new DelegateDataSource({ diagnostics: diagnosticRecorder, watch: diagnosticWatch }), local: true }] : []),
      ...remoteTargets.map((target) => ({
        source: new RemoteDatasource({ baseUrl: target.url, token: target.token, label: target.label }),
        label: target.label,
        local: false
      }))
    ]);
let store = source.getState();
const notifier = new NotificationDispatcher();
notifier.enabled = preferences.notifications;
notifier.observe(store);
let quitting = false;
let inputBatch = false;
let inputDrawPending = false;
let widthProbeInputStage = null;
const ui = {
  screen: initialJobId ? 'detail' : 'dashboard', jobId: initialJobId, version: TUI_PACKAGE_VERSION, now: Date.now(), selectedIndex: 0, scroll: 0,
  activeOnly: false, showExternals: true, filter: '', help: false, helpPage: 0, actionMenu: null, input: null, confirm: null,
  status: '', statusKind: 'info', detailTab: 0, detailScroll: 0, transcriptSelection: null,
  transcriptAnomaliesOnly: false, transcriptKindFilter: null,
  subagentSelection: 0, subagentTranscriptId: null, subagentTranscriptSelection: 0, guardiansExpanded: false,
  diffSelection: 0, diffFile: null, diffPaths: [], diffWindow: null, eventFilter: '', eventCategoryFilter: null, follow: true,
  expandedTools: new Set(), expandedEvents: new Set(), eventSelection: null,
  chainSelection: 0, search: null, detailReturn: initialJobId ? 'dashboard' : 'fleet',
  dashboardFocus: 0, dashboardAttentionSelection: 0, dashboardFeedSelection: 0, focusedPane: 0,
  groupSelection: 0, groupScroll: 0, groupId: null, groupMemberSelection: 0, groupMemberScroll: 0,
  sessionSelection: 0, sessionScroll: 0, sessionCwdFilter: null, sessionJobIds: null,
  providerScroll: 0, statsSelection: 0, statsScroll: 0, statsFilter: '', notifyEnabled: notifier.enabled,
  workIndex: 0, workTab: 0, workScroll: 0,
  timestampMode: preferences.timestampMode, fleetDensity: preferences.fleetDensity, fleetSort: 'recency', theme: preferences.theme,
  statusHistory: [], statusHistoryOpen: false, statusHistoryPage: 0, terminalFocused: true, gPrefix: false, gPrefixHelp: false,
  remote: store.remote || null,
  launcher: {
    fieldIndex: 0, intentSource: '<packet>', profile: '<none>', provider: 'codex', model: 'auto',
    mode: 'consult', effort: '<default>', prompt: '', allowedPaths: '',
    acceptanceCriteria: '', verifyCommand: '', wallTimeSeconds: '',
    maxRounds: '', maxOutputTokens: '', ingestFiles: '', routeAdvice: null,
    preview: null, previewSignature: null, previewScroll: 0
  }
};
let routeAdviceTimer = null;
let renderedGrid = null;
let pendingInputAtNs = null;
let activeInputTiming = null;
const spinnerAnimator = new SpinnerAnimator({
  onTick(now) {
    if (quitting || !renderedGrid) return;
    const next = advanceSpinnerGrid(renderedGrid, now);
    if (!next) {
      spinnerAnimator.setActive(false);
      return;
    }
    renderedGrid = next;
    screen.render(next, { timing: { cause: 'animation', screen: ui.screen, detailTab: ui.detailTab } });
  }
});
let gPrefixTimer = null;

function viewport() {
  return { width: screen.columns, height: screen.rows };
}

function viewModel() {
  return createViewModel(store, ui, viewport());
}

function draw(cause = 'state') {
  if (quitting) return;
  if (inputBatch) {
    inputDrawPending = true;
    return;
  }
  if (activeInputTiming) cause = 'input';
  const drawStartedNs = process.hrtime.bigint();
  const drawStarted = performance.now();
  const wrapBefore = { hits: defaultWrapCache.hits, misses: defaultWrapCache.misses, wrapCalls: defaultWrapCache.wrapCalls };
  const frame = viewModel();
  const viewModelFinished = performance.now();
  renderedGrid = paintFrame(frame);
  const paintFinished = performance.now();
  const projection = frame.meta?.projectionMetrics || null;
  const inputQueueMs = activeInputTiming?.atNs == null
    ? null
    : Number(drawStartedNs - BigInt(activeInputTiming.atNs)) / 1_000_000;
  screen.render(renderedGrid, {
    timing: {
      cause,
      screen: frame.screen,
      detailTab: frame.meta?.tab,
      detailTabLabel: frame.tabs?.items?.[frame.meta?.tab],
      inputId: activeInputTiming?.id || null,
      inputAtNs: activeInputTiming?.atNs || null,
      inputEvents: activeInputTiming?.events || null,
      inputQueueMs,
      viewModelMs: viewModelFinished - drawStarted,
      paintFrameMs: paintFinished - viewModelFinished,
      projectionMs: projection?.durationMs,
      projectionVisited: projection?.visited,
      projectionChanged: projection?.changed,
      projectionBaseRebuilt: projection?.baseRebuilt,
      wrapHits: defaultWrapCache.hits - wrapBefore.hits,
      wrapMisses: defaultWrapCache.misses - wrapBefore.misses,
      wrapCalls: defaultWrapCache.wrapCalls - wrapBefore.wrapCalls
    }
  });
  spinnerAnimator.setActive(ui.terminalFocused && renderedGrid.spinnerCells.size > 0);
  if (!source.readOnly && frame.meta?.reconcileJobIds?.length) void source.reconcileVisibleJobs(frame.meta.reconcileJobIds, { limit: 5 });
}

function addStatusHistory(message, kind = 'info', stream = null) {
  const rendered = formatDisplayValue(message);
  if (!rendered) return;
  ui.statusHistory.push({ at: Date.now(), message: rendered, kind, stream });
  if (ui.statusHistory.length > 20) ui.statusHistory.splice(0, ui.statusHistory.length - 20);
}

function setStatus(message, kind = 'info') {
  ui.status = formatDisplayValue(message);
  ui.statusKind = kind;
  addStatusHistory(ui.status, kind);
}

function clearStatus() {
  ui.status = '';
  ui.statusKind = 'info';
}

function persistPreferences() {
  try {
    saveTuiPreferences({
      theme: ui.theme,
      notifications: ui.notifyEnabled,
      timestampMode: ui.timestampMode,
      fleetDensity: ui.fleetDensity,
      widthProbeCache
    });
    return true;
  } catch (error) {
    setStatus(`Could not save TUI preferences: ${formatDisplayValue(error?.message)}`, 'error');
    return false;
  }
}

function refresh() {
  store = source.refresh();
  draw('refresh');
}

async function quit(code = 0) {
  if (quitting) return;
  quitting = true;
  clearInterval(clock);
  spinnerAnimator.stop();
  if (routeAdviceTimer) clearTimeout(routeAdviceTimer);
  if (gPrefixTimer) clearTimeout(gPrefixTimer);
  await source.close();
  bufferedInput.close();
  detachTuiInput();
  widthProbeInputStage?.teardown();
  screen.stop();
  process.exit(code);
}

function liveJob(id) {
  const job = loadJob(id);
  if (!job) throw Object.assign(new Error(`job not found: ${id}`), { code: 'NOT_FOUND' });
  return job;
}

function selectedJob() {
  if (ui.screen === 'detail') return store.jobs.find((job) => job.id === ui.jobId) || null;
  const model = viewModel();
  const id = model.meta?.selectedJobId || model.meta?.jobId;
  return store.jobs.find((job) => job.id === id) || null;
}

function currentKeymapContext(frame = viewModel()) {
  return keymapContext(frame, ui, store);
}

function runMutation(action, success) {
  try {
    const result = action();
    setStatus(typeof success === 'function' ? success(result) : success);
    refresh();
    return result;
  } catch (error) {
    const typed = normalizeBrokerError(error, { defaultCode: 'INTERNAL' });
    setStatus(`[${typed.code}] ${typed.message}`, 'error');
    refresh();
    return null;
  }
}

function beginInput(action, label, value = '', extra = {}) {
  ui.input = { action, label, value: String(value || ''), ...extra };
  draw();
}

function searchablePane() {
  if (ui.screen !== 'detail') return null;
  const pane = ui.detailTab === 0 ? 'transcript' : ui.detailTab === 4 ? 'events' : ui.detailTab === 1 && ui.diffFile ? 'diff' : null;
  if (!pane) return null;
  const content = viewModel().panes?.[0]?.content;
  return content?.virtual ? { pane, content } : null;
}

function setSearchQuery(value, options = {}) {
  if (!ui.search) return;
  ui.search.query = String(value || '');
  ui.search.matches = ui.search.index.find(ui.search.query);
  if (options.preserveCurrent) ui.search.current = Math.min(Math.max(0, ui.search.current || 0), Math.max(0, ui.search.matches.length - 1));
  else ui.search.current = 0;
  if (ui.search.matches.length) {
    const pane = searchablePane();
    if (pane) {
      ui.detailScroll = virtualSearchPosition(pane.content, ui.search.matches[ui.search.current], detailViewport().width);
      if (pane.pane === 'transcript') ui.transcriptSelection = ui.search.matches[ui.search.current].entry;
      ui.follow = false;
    }
  }
}

function beginPaneSearch() {
  const pane = searchablePane();
  if (!pane) {
    setStatus('Search is available in Transcript, Events, or an opened Diff file', 'error');
    draw();
    return;
  }
  const previous = ui.search?.pane === pane.pane ? ui.search.query : '';
  ui.search = {
    pane: pane.pane,
    index: new LogicalSearchIndex(pane.content.entries || [], pane.content.formatEntry),
    query: '', matches: [], current: 0
  };
  setSearchQuery(previous);
  beginInput('pane-search', `Search ${pane.pane}`, previous, { pane: pane.pane });
}

function rebuildPaneSearch() {
  if (!ui.search || ui.screen !== 'detail') return;
  const pane = searchablePane();
  if (!pane || pane.pane !== ui.search.pane) {
    ui.search = null;
    return;
  }
  const query = ui.search.query;
  const current = ui.search.current;
  ui.search.index = new LogicalSearchIndex(pane.content.entries || [], pane.content.formatEntry);
  ui.search.current = current;
  setSearchQuery(query, { preserveCurrent: true });
}

function clearSearch() {
  ui.search = null;
  if (ui.input?.action === 'pane-search') ui.input = null;
}

function jumpSearch(direction) {
  if (!ui.search?.query || !ui.search.matches.length) return false;
  ui.search.current = nextSearchMatch(ui.search.current, ui.search.matches.length, direction);
  const pane = searchablePane();
  if (pane) {
    ui.detailScroll = virtualSearchPosition(pane.content, ui.search.matches[ui.search.current], detailViewport().width);
    if (pane.pane === 'transcript') ui.transcriptSelection = ui.search.matches[ui.search.current].entry;
    ui.follow = false;
  }
  draw();
  return true;
}

function handoffText(text) {
  if (!String(process.env.VISUAL || process.env.EDITOR || '').trim()) return editTextInEditor({ screen, text });
  try {
    return withEditorInputHandoff({
      widthProbeStage: widthProbeInputStage,
      detachInput: detachTuiInput,
      attachInput: attachTuiInput,
      handoff: () => editTextInEditor({ screen, text })
    });
  } catch (error) {
    return { available: true, accepted: false, text, status: null, signal: null, error };
  }
}

function editLauncherBody() {
  const result = handoffText(ui.launcher.prompt);
  if (!result.available) {
    setStatus('VISUAL/EDITOR is not set; editing the packet body inline', 'info');
    const fields = viewModel().meta.fields;
    ui.launcher.fieldIndex = Math.max(0, fields.indexOf('prompt'));
    beginInput('launcher-field', 'Packet body', ui.launcher.prompt, { field: 'prompt' });
    return;
  }
  if (!result.accepted) {
    const reason = result.signal ? `signal ${result.signal}` : `exit ${result.status ?? 'error'}`;
    setStatus(`Editor failed (${reason}); previous packet body kept`, 'error');
    draw();
    return;
  }
  ui.launcher.prompt = result.text;
  invalidatePreview();
  scheduleRouteAdvice();
  setStatus('Packet body updated from $EDITOR');
  draw();
}

function submitReviewRound(jobId, findings) {
  if (!String(findings || '').trim()) {
    setStatus('Review-round findings are required', 'error');
    draw();
    return;
  }
  runMutation(() => reviewRoundManagedJob(jobId, { prompt: String(findings).trim(), reportLint: false }), (child) => `Review round resumed as ${child.id}`);
}

function beginReviewRound(job) {
  if (!job || !TERMINAL.has(job.status)) {
    setStatus('Review round is available only for terminal jobs', 'error');
    draw();
    return;
  }
  try {
    const inspected = inspectJob(job.id);
    if (!inspected.resumable?.ok) {
      setStatus(`Review round refused: ${inspected.resumable?.reason || 'parent is not resumable'}`, 'error');
      draw();
      return;
    }
  } catch (error) {
    const typed = normalizeBrokerError(error, { defaultCode: 'INTERNAL' });
    setStatus(`[${typed.code}] ${typed.message}`, 'error');
    draw();
    return;
  }
  const result = handoffText('');
  if (!result.available) {
    setStatus('VISUAL/EDITOR is not set; enter review findings inline');
    beginInput('review-round', 'Review findings', '', { jobId: job.id });
  } else if (!result.accepted) {
    const reason = result.signal ? `signal ${result.signal}` : `exit ${result.status ?? 'error'}`;
    setStatus(`Editor failed (${reason}); enter review findings inline`, 'error');
    beginInput('review-round', 'Review findings', '', { jobId: job.id });
  } else {
    submitReviewRound(job.id, result.text);
  }
}

function launcherIntentSources(launcher) {
  const source = launcher.intentSource || '<packet>';
  if (source === '<packet>') return [];
  if (source === 'sentence') return [{ kind: 'sentence', text: launcher.prompt }];
  if (source === 'diff') {
    return [
      ...(String(launcher.prompt || '').trim() ? [{ kind: 'sentence', text: launcher.prompt }] : []),
      { kind: 'diff' }
    ];
  }
  if (source === 'failure') return [{ kind: 'failure', text: launcher.prompt }];
  if (source === 'todo') return [{ kind: 'todo', path: launcher.prompt }];
  if (source === 'task-record') return [{ kind: 'task-record', path: launcher.prompt }];
  return [{ kind: 'conventions' }];
}

function compileLauncherSpec() {
  const launcher = ui.launcher;
  if (launcher.profile && launcher.profile !== '<none>') {
    throw new Error('Profiles wrap hand-written packets only; choose <none> for intent compilation');
  }
  const allowedPaths = String(launcher.allowedPaths || '').split(',').map((entry) => entry.trim()).filter(Boolean);
  const ingestFiles = String(launcher.ingestFiles || '').split(',').map((entry) => entry.trim()).filter(Boolean);
  const acceptanceCriteria = String(launcher.acceptanceCriteria || '').split(/\r?\n|;/).map((entry) => entry.trim()).filter(Boolean);
  const verifyCommand = String(launcher.verifyCommand || '').trim();
  const budget = {
    wallTimeSeconds: Number(launcher.wallTimeSeconds) || null,
    maxRounds: Number(launcher.maxRounds) || null,
    maxOutputTokens: Number(launcher.maxOutputTokens) || null
  };
  return compileIntentSpec({
    cwd: process.cwd(),
    mode: launcher.mode || 'implement',
    sources: launcherIntentSources(launcher),
    explicit: {
      ...(allowedPaths.length ? { scopeClaim: allowedPaths } : {}),
      ...(acceptanceCriteria.length ? { acceptanceCriteria } : {}),
      ...(verifyCommand ? { verifyRecipe: { command: verifyCommand, timeoutSeconds: 600 } } : {}),
      budget
    },
    authority: { allowedPaths, ingestFiles }
  });
}

function launchOptions(settings = {}) {
  const launcher = ui.launcher;
  const allowedPaths = String(launcher.allowedPaths || '').split(',').map((entry) => entry.trim()).filter(Boolean);
  const ingestFiles = String(launcher.ingestFiles || '').split(',').map((entry) => entry.trim()).filter(Boolean);
  const verifyCommand = String(launcher.verifyCommand || '').trim();
  const base = {
    provider: launcher.provider,
    model: launcher.model || 'auto',
    mode: launcher.mode || 'consult',
    ...(launcher.profile && launcher.profile !== '<none>' ? { profile: launcher.profile } : {}),
    ...(launcher.effort && launcher.effort !== '<default>' ? { effort: launcher.effort } : {}),
    prompt: launcher.prompt,
    reportLint: false,
    cwd: process.cwd(),
    ...(allowedPaths.length ? { allowedPaths } : {}),
    ...(verifyCommand ? { verify: { command: verifyCommand } } : {}),
    ...(ingestFiles.length ? { ingestFiles } : {})
  };
  if ((launcher.intentSource || '<packet>') === '<packet>') return base;
  const compilation = settings.compilation || compileLauncherSpec();
  const compiled = settings.confirmed
    ? launchOptionsFromCompilation(confirmCompiledSpec(compilation, 'tui'))
    : previewOptionsFromCompilation(compilation);
  return { ...base, ...compiled, mode: compilation.mode };
}

function updateRouteAdvice() {
  const effort = ui.launcher.effort === '<default>' ? 'medium' : ui.launcher.effort;
  const usage = Object.fromEntries((store.providers || []).map((provider) => [provider.name, provider.allowance || { known: false }]));
  const availability = { claude: true, codex: true, cursor: true, ...Object.fromEntries((store.providers || []).map((provider) => [provider.name, provider.enabled !== false])) };
  try {
    ui.launcher.routeAdvice = routeTask({
      task: ui.launcher.prompt || '', mode: ui.launcher.mode, model: ui.launcher.model || 'auto', effort,
      costBands: auditUsageBands(store.audit || []), usage, availability
    });
  } catch {
    ui.launcher.routeAdvice = null;
  }
}

function scheduleRouteAdvice() {
  if (routeAdviceTimer) clearTimeout(routeAdviceTimer);
  routeAdviceTimer = setTimeout(() => {
    routeAdviceTimer = null;
    updateRouteAdvice();
    draw();
  }, 80);
  routeAdviceTimer.unref?.();
}

function launcherSignature() {
  const { preview, previewSignature, previewScroll, routeAdvice, ...form } = ui.launcher;
  return JSON.stringify(form);
}

function invalidatePreview() {
  ui.launcher.preview = null;
  ui.launcher.previewSignature = null;
}

function dryRunLaunch() {
  const preview = runMutation(() => {
    const compilation = (ui.launcher.intentSource || '<packet>') === '<packet>' ? null : compileLauncherSpec();
    const result = compilation && !compilation.ready
      ? {
          dryRun: true,
          compileOnly: true,
          provider: ui.launcher.provider,
          model: ui.launcher.model,
          mode: ui.launcher.mode,
          packetWarnings: [],
          confirmationCard: compilation.card,
          unresolved: compilation.unresolved,
          packet: null
        }
      : launchManagedJob({ ...launchOptions({ compilation }), dryRun: true });
    if (compilation) {
      result.confirmationCard = compilation.card;
      result.specDigest = compilation.digest;
      result.unresolved = compilation.unresolved;
    }
    ui.launcher.preview = result;
    ui.launcher.previewSignature = launcherSignature();
    ui.launcher.previewScroll = 0;
    return result;
  }, (result) => result.unresolved?.length
    ? `WorkSpec blocked: resolve ${result.unresolved.join(', ')}`
    : `Dry run ready: ${result.provider}/${result.model}; confirm launch in the overlay`);
  if (!preview) return;
  if (preview.unresolved?.length) {
    ui.confirm = null;
    draw();
    return;
  }
  ui.confirm = {
    action: 'launch',
    expected: 'launch',
    value: '',
    danger: false,
    title: `Launch dry run${CHROME_SEPARATOR}${preview.provider}/${preview.model}`,
    lines: [
      'The exact dry-run packet remains visible in the launcher review pane.',
      'Launching creates a managed job and may consume provider allowance.',
      'Type launch to start this exact packet.'
    ],
    label: 'Confirm'
  };
  draw();
}

function launchPreviewed() {
  if (!ui.launcher.preview || ui.launcher.previewSignature !== launcherSignature()) {
    setStatus('The current form has no matching dry-run preview; press d first', 'error');
    draw();
    return;
  }
  const started = runMutation(() => launchManagedJob(launchOptions({ confirmed: true })), (job) => `Launched ${job.id}`);
  if (started) {
    ui.screen = 'fleet';
    ui.selectedIndex = 0;
    draw();
  }
}

function commitInput() {
  const input = ui.input;
  if (!input) return;
  ui.input = null;
  const value = input.value;
  if (input.action === 'fleet-filter') {
    ui.filter = value;
    if (ui.screen === 'group-members') ui.groupMemberSelection = 0;
    else ui.selectedIndex = 0;
    clearStatus();
  } else if (input.action === 'event-filter') {
    ui.eventFilter = value;
    ui.detailScroll = 0;
    clearStatus();
  } else if (input.action === 'stats-filter') {
    ui.statsFilter = value;
    ui.statsSelection = 0;
    clearStatus();
  } else if (input.action === 'pane-search') {
    setSearchQuery(value, { preserveCurrent: true });
    clearStatus();
  } else if (input.action === 'launcher-field') {
    ui.launcher[input.field] = value;
    invalidatePreview();
    scheduleRouteAdvice();
    clearStatus();
  } else if (input.action === 'steer') {
    if (!value.trim()) setStatus('Steering text is required', 'error');
    else runMutation(() => {
      const job = liveJob(input.jobId);
      return submitControl(job.id, { type: 'steer', correctionId: crypto.randomUUID(), strategy: 'auto', text: value.trim() }, job.revision);
    }, (result) => `Steer queued at revision ${result.revision}`);
  } else if (input.action === 'answer') {
    if (!value.trim()) setStatus('Answer text is required', 'error');
    else runMutation(() => {
      const job = liveJob(input.jobId);
      if (!job.pendingInput || job.pendingInput.timedOut === true) throw new Error('No worker question is pending');
      return submitControl(job.id, {
        type: 'respond',
        requestId: job.pendingInput.requestId,
        commandId: crypto.randomUUID(),
        answer: value.trim()
      }, job.revision);
    }, (result) => `Answer queued at revision ${result.revision}`);
  } else if (input.action === 'resume') {
    if (!value.trim()) setStatus('Resume text is required', 'error');
    else runMutation(() => resumeManagedJob(input.jobId, { prompt: value.trim(), reportLint: false }), (job) => `Resumed as ${job.id}`);
  } else if (input.action === 'review-round') {
    submitReviewRound(input.jobId, value);
  }
  draw();
}

function commitConfirm() {
  const confirm = ui.confirm;
  if (!confirm) return;
  if (confirm.value !== confirm.expected) {
    setStatus(`Confirmation did not match ${confirm.expected}`, 'error');
    draw();
    return;
  }
  ui.confirm = null;
  if (confirm.action === 'cancel') {
    runMutation(() => {
      const job = liveJob(confirm.jobId);
      return submitControl(job.id, { type: 'cancel', commandId: crypto.randomUUID() }, job.revision);
    }, (result) => `Cancellation queued at revision ${result.revision}`);
  } else if (confirm.action === 'revert') {
    runMutation(() => revertManagedJob(confirm.jobId), (result) => `Revert finished: ${result.reverted.length} reverted, ${result.skipped.length} skipped, ${result.conflicts.length} conflicts`);
  } else if (confirm.action === 'launch') {
    launchPreviewed();
  } else if (confirm.action === 'work-accept' || confirm.action === 'work-reject') {
    const decision = confirm.action === 'work-accept' ? 'accepted' : 'rejected';
    runMutation(
      () => decideAcceptance(confirm.jobId, decision, { decidedBy: 'tui:owner' }),
      (result) => `Evidence-bound decision recorded: ${result.acceptance.state}`
    );
  } else if (confirm.action === 'work-integrate') {
    runMutation(
      () => prepareManagedIntegration(confirm.jobIds),
      (result) => result.applied
        ? `Integration worktree prepared: ${result.integration.id}; owner tree unchanged`
        : `Integration stopped at ${result.stage}: ${result.conflicts?.length || 0} conflicts`
    );
  }
  draw();
}

function editValue(key) {
  const target = ui.confirm || ui.input;
  if (!target) return false;
  if (key && typeof key === 'object' && key.type === 'paste') {
    target.value += String(key.text || '');
    if (target.action === 'pane-search') setSearchQuery(target.value);
    if (target.action === 'stats-filter') { ui.statsFilter = target.value; ui.statsSelection = 0; }
    draw();
    return true;
  }
  if (key === 'escape') {
    if (ui.confirm) ui.confirm = null;
    else if (ui.input?.action === 'pane-search') clearSearch();
    else ui.input = null;
    draw();
    return true;
  }
  if (key === 'enter') {
    if (ui.confirm) commitConfirm();
    else commitInput();
    return true;
  }
  if (key === 'backspace') {
    const graphemes = splitGraphemes(target.value || '');
    graphemes.pop();
    target.value = graphemes.join('');
    if (target.action === 'pane-search') setSearchQuery(target.value);
    if (target.action === 'stats-filter') { ui.statsFilter = target.value; ui.statsSelection = 0; }
    draw();
    return true;
  }
  if (key === 'ctrl-u') {
    target.value = '';
    if (target.action === 'pane-search') setSearchQuery('');
    if (target.action === 'stats-filter') { ui.statsFilter = ''; ui.statsSelection = 0; }
    draw();
    return true;
  }
  if (['up', 'down', 'left', 'right', 'tab', 'shift-tab'].includes(key)) return true;
  if (key.length && !/[\u0000-\u001f\u007f]/.test(key)) {
    target.value += key;
    if (target.action === 'pane-search') setSearchQuery(target.value);
    if (target.action === 'stats-filter') { ui.statsFilter = target.value; ui.statsSelection = 0; }
    draw();
    return true;
  }
  return true;
}

function choiceValues(field) {
  if (field === 'intentSource') return ['<packet>', 'sentence', 'diff', 'failure', 'todo', 'task-record', 'conventions'];
  if (field === 'profile') return ['<none>', ...(store.profiles || [])];
  if (field === 'provider') {
    const enabled = (store.providers || []).filter((provider) => provider.enabled && ['codex', 'cursor'].includes(provider.name)).map((provider) => provider.name);
    return enabled.length ? enabled : ['codex', 'cursor'];
  }
  if (field === 'mode') return ['consult', 'plan', 'review', 'implement', 'verify'];
  if (field === 'effort') return ['<default>', 'low', 'medium', 'high', 'xhigh', 'max', 'ultra'];
  return [];
}

function cycleLauncher(direction) {
  const fields = viewModel().meta.fields;
  const field = fields[ui.launcher.fieldIndex];
  const choices = choiceValues(field);
  if (!choices.length) return;
  const current = Math.max(0, choices.indexOf(ui.launcher[field]));
  ui.launcher[field] = choices[(current + direction + choices.length) % choices.length];
  if (field === 'provider' && !ui.launcher.model) ui.launcher.model = 'auto';
  invalidatePreview();
  scheduleRouteAdvice();
  draw();
}

function editLauncherField() {
  const fields = viewModel().meta.fields;
  const field = fields[ui.launcher.fieldIndex];
  if (CHOICE_FIELDS.has(field)) cycleLauncher(1);
  else {
    const labels = {
      allowedPaths: 'Allowed paths (comma-separated)',
      acceptanceCriteria: 'Acceptance criteria (semicolon/newline-separated)',
      ingestFiles: 'Ingest files (comma-separated absolute paths)',
      verifyCommand: 'Verify command',
      wallTimeSeconds: 'Wall time seconds',
      maxRounds: 'Maximum rounds',
      maxOutputTokens: 'Maximum output tokens',
      prompt: ui.launcher.intentSource === '<packet>' ? 'Packet body' : 'Intent text or source path'
    };
    beginInput('launcher-field', labels[field] || field[0].toUpperCase() + field.slice(1), ui.launcher[field], { field });
  }
}

function openJobDetail(job, returnScreen = ui.screen) {
  if (!job) return;
  ui.screen = 'detail';
  ui.jobId = job.id;
  ui.detailReturn = ['dashboard', 'group-members', 'fleet'].includes(returnScreen) ? returnScreen : 'fleet';
  ui.detailTab = 0;
  ui.detailScroll = 0;
  ui.transcriptSelection = null;
  ui.transcriptAnomaliesOnly = false;
  ui.transcriptKindFilter = null;
  ui.subagentSelection = 0;
  ui.subagentTranscriptId = null;
  ui.subagentTranscriptSelection = 0;
  ui.guardiansExpanded = false;
  ui.chainSelection = 0;
  ui.diffSelection = 0;
  ui.diffFile = null;
  ui.diffPaths = [];
  ui.diffWindow = null;
  ui.expandedTools = new Set();
  ui.expandedEvents = new Set();
  ui.eventSelection = null;
  ui.eventCategoryFilter = null;
  ui.follow = true;
  clearSearch();
  clearStatus();
  draw();
  void source.selectJob(job.id);
}

function openDiffFile() {
  const model = viewModel();
  const path = model.meta.diffFiles?.[ui.diffSelection];
  if (!path) {
    setStatus('No diff file is selected', 'error');
    draw();
    return;
  }
  openDiffPaths([path], path);
}

function openDiffPaths(paths, label = null) {
  const selected = [...new Set(normalizeJobPaths(paths, selectedJob()?.cwd).filter(Boolean))];
  if (!selected.length) {
    setStatus('The focused tool has no journaled file paths', 'error');
    draw();
    return;
  }
  const diff = store.diffsByJob?.[ui.jobId] || '';
  const filtered = filterDiffPaths(diff, selected);
  ui.detailTab = 1;
  ui.diffPaths = selected;
  ui.diffFile = label || (selected.length === 1 ? selected[0] : `${selected.length} tool paths`);
  const stat = store.diffStatsByJob?.[ui.jobId] || {};
  const selectedStats = (stat.files || []).filter((file) => selected.includes(file.path));
  const additions = selectedStats.length
    ? selectedStats.reduce((total, file) => total + Number(file.additions || 0), 0)
    : Number(stat.totalAdditions || 0);
  const deletions = selectedStats.length
    ? selectedStats.reduce((total, file) => total + Number(file.deletions || 0), 0)
    : Number(stat.totalDeletions || 0);
  ui.diffWindow = prepareDiffWindow(sliceDiff(filtered, { offset: 0, maxChars: DIFF_WINDOW }), {
    band: { path: ui.diffFile, additions, deletions }
  });
  ui.detailScroll = 0;
  clearSearch();
  draw();
}

function pageDiff(direction) {
  if (!ui.diffFile) return;
  const diff = filterDiffPaths(store.diffsByJob?.[ui.jobId] || '', ui.diffPaths?.length ? ui.diffPaths : [ui.diffFile]);
  const offset = direction > 0
    ? ui.diffWindow?.nextOffset
    : Math.max(0, Number(ui.diffWindow?.offset || 0) - DIFF_WINDOW);
  if (offset == null) return;
  const stat = store.diffStatsByJob?.[ui.jobId] || {};
  const selectedStats = (stat.files || []).filter((file) => (ui.diffPaths || []).includes(file.path));
  const additions = selectedStats.length
    ? selectedStats.reduce((total, file) => total + Number(file.additions || 0), 0)
    : Number(stat.totalAdditions || 0);
  const deletions = selectedStats.length
    ? selectedStats.reduce((total, file) => total + Number(file.deletions || 0), 0)
    : Number(stat.totalDeletions || 0);
  ui.diffWindow = prepareDiffWindow(sliceDiff(diff, { offset, maxChars: DIFF_WINDOW }), {
    band: { path: ui.diffFile, additions, deletions }
  });
  ui.detailScroll = 0;
  clearSearch();
  draw();
}

function beginCancel(job) {
  if (!job || TERMINAL.has(job.status)) return setStatus('Only active jobs can be cancelled', 'error');
  const expected = job.id.slice(-4);
  ui.confirm = {
    action: 'cancel', jobId: job.id, expected, value: '', danger: true,
    title: `Cancel ${job.id}`,
    lines: [`Cancellation stays pending until the provider acknowledges or exits.`, `Type the last 4 job-id characters to queue cancel: ${expected}`],
    label: 'Suffix'
  };
  draw();
}

function beginRevert(job) {
  if (!job || !TERMINAL.has(job.status)) return setStatus('Revert is available only for terminal jobs', 'error');
  try {
    const plan = revertManagedJob(job.id, { dryRun: true });
    const lines = [
      `DRY RUN: ${plan.reverted.length} revertable, ${plan.skipped.length} skipped, ${plan.conflicts.length} conflicts`,
      ...plan.reverted.map((entry) => `${entry.action}: ${entry.path}`),
      ...plan.skipped.map((entry) => `SKIP ${entry.path}: ${entry.reason}`),
      ...plan.conflicts.map((entry) => `CONFLICT ${entry.path || '<inventory>'}: ${entry.reason}`)
    ];
    if (lines.length > 18) lines.splice(17, lines.length - 17, `... ${lines.length - 17} more plan rows; inspect with delegate-jobs revert --dry-run for the full list`);
    const expected = job.id.slice(-4);
    lines.push(`Type the last 4 job-id characters to apply this safe subset: ${expected}`);
    ui.confirm = { action: 'revert', jobId: job.id, expected, value: '', danger: true, title: `Revert plan${CHROME_SEPARATOR}${job.id}`, lines, label: 'Suffix' };
    draw();
  } catch (error) {
    const typed = normalizeBrokerError(error, { defaultCode: 'INTERNAL' });
    setStatus(`[${typed.code}] ${typed.message}`, 'error');
    draw();
  }
}

function detailAction(key) {
  const job = selectedJob();
  if (!job) return;
  if (key === 's') {
    if (TERMINAL.has(job.status)) setStatus('Steer is available only while a job is active', 'error');
    else beginInput('steer', 'Steer', '', { jobId: job.id });
  } else if (key === 'a') {
    if (!job.pendingInput || job.pendingInput.timedOut === true) setStatus('Answer is available only while a worker question is pending', 'error');
    else beginInput('answer', 'Answer worker question', '', { jobId: job.id });
  } else if (key === 'r') {
    if (!TERMINAL.has(job.status)) setStatus('Resume is available only after terminal state', 'error');
    else beginInput('resume', 'Resume packet', '', { jobId: job.id });
  } else if (key === 'R') {
    if (!job.startPaused || job.phase !== 'paused') setStatus('Release is available only while a start-paused job is paused', 'error');
    else runMutation(() => {
      const live = liveJob(job.id);
      return submitControl(live.id, { type: 'release', commandId: crypto.randomUUID() }, live.revision);
    }, (result) => `Release queued at revision ${result.revision}`);
  } else if (key === 'n') {
    if (!nudgeEligible(job)) setStatus('Nudge requires a terminal read-mode job flagged resultSuspect', 'error');
    else runMutation(() => resumeManagedJob(job.id, { prompt: NUDGE_PROMPT, reportLint: false }), (child) => `Nudge resumed as ${child.id}`);
  } else if (key === 'w') beginReviewRound(job);
  draw();
}

function beginWorkDecision(decision) {
  const model = viewModel();
  const accepted = decision === 'accepted';
  const jobId = accepted ? model.meta?.acceptJobId : model.meta?.rejectJobId;
  const unavailable = accepted ? model.meta?.acceptUnavailable : model.meta?.rejectUnavailable;
  if (!jobId) {
    setStatus(unavailable || `${decision} is unavailable for this WorkItem`, 'error');
    draw();
    return;
  }
  const job = store.jobs.find((candidate) => candidate.id === jobId);
  const expected = jobId.slice(-4);
  ui.confirm = {
    action: accepted ? 'work-accept' : 'work-reject',
    jobId,
    expected,
    value: '',
    danger: !accepted,
    title: `${accepted ? 'Accept' : 'Reject'} evidence${CHROME_SEPARATOR}${jobId}`,
    lines: [
      `Current acceptance: ${formatDisplayValue(job?.acceptance?.state || 'missing')}`,
      `Evidence digest: ${formatDisplayValue(job?.acceptance?.evidenceDigest || 'broker will bind the current evidence')}`,
      accepted
        ? 'This records acceptance only; it does not apply changes into the owner tree.'
        : 'This records rejection against the current evidence.',
      `Type the last 4 job-id characters to record the decision: ${expected}`
    ],
    label: 'Suffix'
  };
  draw();
}

function beginWorkIntegration() {
  const model = viewModel();
  const jobIds = model.meta?.integrationJobIds || [];
  if (!jobIds.length) {
    setStatus(model.meta?.integrationUnavailable || 'Integration composition is unavailable', 'error');
    draw();
    return;
  }
  try {
    const preflight = preflightManagedIntegration(jobIds);
    if (!preflight.ok) {
      const conflicts = (preflight.conflicts || []).map((entry) => `${formatDisplayValue(entry.path || '<inventory>')}: ${formatDisplayValue(entry.reason)}`);
      setStatus(`Integration preflight blocked: ${conflicts.join('; ') || 'unknown conflict'}`, 'error');
      draw();
      return;
    }
    ui.confirm = {
      action: 'work-integrate',
      jobIds,
      expected: 'integrate',
      value: '',
      danger: false,
      title: `Compose integration worktree${CHROME_SEPARATOR}${jobIds.length} change set${jobIds.length === 1 ? '' : 's'}`,
      lines: [
        `CAS preflight passed at ${formatDisplayValue(preflight.currentRevision || 'current HEAD')}.`,
        'Composition writes only a broker-owned integration worktree.',
        'Direct application into the owner working tree remains disabled.',
        'Type integrate to prepare the integration worktree.'
      ],
      label: 'Confirm'
    };
    draw();
  } catch (error) {
    const typed = normalizeBrokerError(error, { defaultCode: 'INTERNAL' });
    setStatus(`[${typed.code}] ${typed.message}`, 'error');
    draw();
  }
}

function workAction(key) {
  const model = viewModel();
  if (['a', 'r', 'i'].includes(key) && model.meta?.workTab !== 2) {
    setStatus('Open Approve mode before recording a decision or composing an integration worktree', 'error');
    draw();
    return;
  }
  if (key === 'w' && model.meta?.workTab !== 5) {
    setStatus('Open Converge mode to inspect the bounded next-round policy first', 'error');
    draw();
    return;
  }
  if (key === 'a') beginWorkDecision('accepted');
  else if (key === 'r') beginWorkDecision('rejected');
  else if (key === 'i') beginWorkIntegration();
  else if (key === 'w') {
    const job = (store.jobs || []).find((candidate) => candidate.id === model.meta?.nextRoundJobId);
    if (!job) {
      setStatus(model.meta?.nextRoundUnavailable || 'Bounded next round is unavailable', 'error');
      draw();
      return;
    }
    beginReviewRound(job);
  }
}

function detailViewport(model = viewModel()) {
  const pane = model.panes?.[0];
  const rect = pane ? paneContentRect(pane, { scrollbar: ['table', 'log', 'text'].includes(pane.content?.kind) }) : null;
  return {
    content: pane?.content,
    height: Math.max(1, rect?.height || 1),
    width: Math.max(1, rect?.width || 1)
  };
}

function focusedTranscriptBlock() {
  if (ui.screen !== 'detail' || ui.detailTab !== 0) return null;
  const entries = viewModel().panes?.[0]?.content?.entries || [];
  if (!entries.length) return null;
  const index = ui.follow
    ? entries.length - 1
    : Math.max(0, Math.min(entries.length - 1, Number(ui.transcriptSelection ?? ui.detailScroll?.entry ?? ui.detailScroll ?? 0)));
  return entries[index] || null;
}

function focusedClipboardValue() {
  const model = viewModel();
  if (ui.screen === 'fleet' || ui.screen === 'group-members') {
    const id = model.meta?.selectedJobId;
    return id ? { value: formatDisplayValue(id), label: 'job id' } : null;
  }
  if (ui.screen === 'launcher') {
    const field = model.meta?.fields?.[ui.launcher.fieldIndex];
    return field ? { value: formatDisplayValue(ui.launcher[field]), label: `${field} value` } : null;
  }
  if (ui.screen !== 'detail') return null;
  if (ui.detailTab === 0) {
    const block = focusedTranscriptBlock();
    if (!block) return null;
    if (block.kind === 'tool' && block.tool.command) return { value: formatDisplayValue(block.tool.command), label: 'command' };
    const paths = transcriptToolPaths(block, selectedJob()?.cwd);
    if (paths[0]) return { value: paths[0], label: 'file path' };
    return { value: formatDisplayValue(block.text) || formatTranscriptBlock(block), label: 'transcript block' };
  }
  if (ui.detailTab === 1) {
    if (ui.diffFile) return { value: formatDisplayValue(ui.diffPaths?.[0] || ui.diffFile), label: 'file path' };
    const file = model.meta?.diffFiles?.[ui.diffSelection];
    return file ? { value: formatDisplayValue(file), label: 'file path' } : null;
  }
  return null;
}

function copyFocused() {
  const focused = focusedClipboardValue();
  if (!focused?.value || !copyToClipboard(focused.value)) return false;
  setStatus(`Copied ${focused.label} to clipboard`);
  draw();
  return true;
}

function toggleToolBlock(block) {
  if (block?.kind !== 'tool') return false;
  const expanded = new Set(ui.expandedTools);
  if (expanded.has(block.tool.key)) expanded.delete(block.tool.key);
  else expanded.add(block.tool.key);
  ui.expandedTools = expanded;
  rebuildPaneSearch();
  const { content, width, height } = detailViewport();
  if (content?.virtual && ui.transcriptSelection != null) {
    ui.detailScroll = virtualLogScrollToEntry(content, ui.transcriptSelection, width, height);
  }
  draw();
  return true;
}

function toggleFocusedTool() {
  return toggleToolBlock(focusedTranscriptBlock());
}

function focusedEventBlock() {
  if (ui.screen !== 'detail' || ui.detailTab !== 4) return null;
  const entries = viewModel().panes?.[0]?.content?.entries || [];
  if (!entries.length) return null;
  const index = ui.follow ? entries.length - 1
    : Math.max(0, Math.min(entries.length - 1, Number(ui.eventSelection ?? ui.detailScroll?.entry ?? 0)));
  return entries[index] || null;
}

function toggleFocusedEvent() {
  const block = focusedEventBlock();
  if (!block) return false;
  const expanded = new Set(ui.expandedEvents);
  if (expanded.has(block.key)) expanded.delete(block.key);
  else expanded.add(block.key);
  ui.expandedEvents = expanded;
  rebuildPaneSearch();
  const { content, width, height } = detailViewport();
  if (content?.virtual && ui.eventSelection != null) {
    const target = virtualLogScrollToEntry(content, ui.eventSelection, width, height);
    const settled = settleVirtualFollow(content, target, width, height, { selectedEntry: ui.eventSelection });
    ui.detailScroll = settled.scroll;
    ui.follow = settled.follow;
  }
  draw();
  return true;
}

function openFocusedToolDiff() {
  const block = focusedTranscriptBlock();
  const job = selectedJob();
  if (!['tool', 'file-change'].includes(block?.kind) || !job) return false;
  const paths = transcriptToolPaths(block, job.cwd);
  if (!paths.length) return false;
  openDiffPaths(paths, paths.length === 1 ? paths[0] : `${paths.length} changed paths`);
  return true;
}

function jumpTranscriptToEvents() {
  const block = focusedTranscriptBlock();
  if (!block) return false;
  const targetSeq = Number(block.seqStart || block.seqEnd || 0);
  ui.detailTab = 4;
  ui.detailScroll = 0;
  ui.follow = false;
  clearSearch();
  const events = store.eventsByJob?.[ui.jobId] || [];
  const index = events.findIndex((event) => Number(event.seq || 0) >= targetSeq);
  ui.detailScroll = { entry: index < 0 ? Math.max(0, events.length - 1) : index, line: 0 };
  draw();
  return true;
}

function moveVirtualDetail(content, direction, width, height) {
  const bottom = virtualLogBottomPosition(content, width, height);
  if (ui.follow) {
    if (direction > 0) return;
    ui.detailScroll = bottom;
    ui.follow = false;
  }
  const next = scrollVirtualLog(content, ui.detailScroll, direction, width);
  const settled = settleVirtualFollow(content, next, width, height);
  ui.detailScroll = settled.scroll;
  ui.follow = settled.follow;
}

function providerScrollMax() {
  const providerHeight = Math.max(6, Math.min(10, Math.floor((screen.rows - 2) / 2)));
  const visible = Math.max(1, screen.rows - providerHeight - 4);
  return Math.max(0, (store.writerLocks?.length || 0) - visible);
}

function move(direction, options = {}) {
  if (ui.screen === 'dashboard') {
    const model = viewModel();
    if (ui.dashboardFocus === 1) {
      const count = model.meta.feedJobIds.length;
      ui.dashboardFeedSelection = Math.max(0, Math.min(Math.max(0, count - 1), ui.dashboardFeedSelection + direction));
    } else {
      const count = model.meta.attentionJobIds.length;
      ui.dashboardAttentionSelection = Math.max(0, Math.min(Math.max(0, count - 1), ui.dashboardAttentionSelection + direction));
    }
  } else if (ui.screen === 'fleet') {
    const count = viewModel().meta.visibleJobIds.length;
    ui.selectedIndex = Math.max(0, Math.min(Math.max(0, count - 1), ui.selectedIndex + direction));
  } else if (ui.screen === 'detail') {
    const model = viewModel();
    if (ui.detailTab === 1 && !ui.diffFile) {
      const count = model.meta.diffFiles.length;
      ui.diffSelection = Math.max(0, Math.min(Math.max(0, count - 1), ui.diffSelection + direction));
    } else if (model.meta.tabs?.[ui.detailTab] === 'Subagents' && !ui.subagentTranscriptId) {
      const count = model.meta.subagentRowIds.length;
      ui.subagentSelection = Math.max(0, Math.min(Math.max(0, count - 1), ui.subagentSelection + direction));
    } else if (model.meta.tabs?.[ui.detailTab] === 'Chain') {
      const count = model.meta.chainJobIds.length;
      ui.chainSelection = Math.max(0, Math.min(Math.max(0, count - 1), ui.chainSelection + direction));
    } else {
      const { content, height, width } = detailViewport(model);
      if (content?.virtual) {
        if ([0, 4].includes(ui.detailTab) && options.select) {
          const count = content.entries?.length || 0;
          const fallback = ui.follow ? count - 1 : Number(ui.detailScroll?.entry ?? ui.detailScroll ?? 0);
          const field = ui.detailTab === 0 ? 'transcriptSelection' : 'eventSelection';
          const stepped = stepVirtualLogSelection({ ...content, follow: false, scroll: ui.detailScroll }, Number(ui[field] ?? fallback), direction, width, height);
          ui[field] = stepped.selectedEntry;
          const settled = settleVirtualFollow(content, stepped.scroll, width, height, { selectedEntry: stepped.selectedEntry });
          ui.detailScroll = settled.scroll;
          ui.follow = settled.follow;
        } else {
          moveVirtualDetail(content, direction, width, height);
          if (ui.detailTab === 0) ui.transcriptSelection = ui.follow ? Math.max(0, (content.entries?.length || 1) - 1) : Number(ui.detailScroll?.entry ?? 0);
          if (ui.detailTab === 4) ui.eventSelection = ui.follow ? Math.max(0, (content.entries?.length || 1) - 1) : Number(ui.detailScroll?.entry ?? 0);
        }
      } else {
        const count = model.meta.scrollItemCount || 0;
        const maxScroll = Math.max(0, count - height);
        ui.detailScroll = Math.max(0, Math.min(maxScroll, Number(ui.detailScroll || 0) + direction));
      }
    }
  } else if (ui.screen === 'work') {
    const count = viewModel().meta.scrollItemCount || 0;
    const pane = viewModel().panes?.[Math.max(0, Math.min((viewModel().panes?.length || 1) - 1, ui.focusedPane || 0))];
    const visible = Math.max(1, paneContentRect(pane || { rect: { width: screen.columns, height: screen.rows } }, { scrollbar: true }).height);
    ui.workScroll = Math.max(0, Math.min(Math.max(0, count - visible), Number(ui.workScroll || 0) + direction));
  } else if (ui.screen === 'groups') {
    const count = store.groups?.length || 0;
    ui.groupSelection = Math.max(0, Math.min(Math.max(0, count - 1), ui.groupSelection + direction));
  } else if (ui.screen === 'group-members') {
    const count = viewModel().meta.visibleJobIds.length;
    ui.groupMemberSelection = Math.max(0, Math.min(Math.max(0, count - 1), ui.groupMemberSelection + direction));
  } else if (ui.screen === 'sessions') {
    const count = viewModel().meta.sessionIds.length;
    ui.sessionSelection = Math.max(0, Math.min(Math.max(0, count - 1), ui.sessionSelection + direction));
  } else if (ui.screen === 'providers') ui.providerScroll = Math.max(0, Math.min(providerScrollMax(), ui.providerScroll + direction));
  else if (ui.screen === 'stats') {
    const count = viewModel().meta.visibleStatsCount || 0;
    ui.statsSelection = Math.max(0, Math.min(Math.max(0, count - 1), ui.statsSelection + direction));
  } else if (ui.screen === 'launcher') {
    const count = viewModel().meta.fields.length;
    ui.launcher.fieldIndex = Math.max(0, Math.min(count - 1, ui.launcher.fieldIndex + direction));
  }
  draw();
}

function page(direction) {
  move(direction * Math.max(3, screen.rows - 6));
}

function moveEdge(end) {
  const model = viewModel();
  if (ui.screen === 'dashboard') {
    if (ui.dashboardFocus === 1) ui.dashboardFeedSelection = end ? Math.max(0, model.meta.feedJobIds.length - 1) : 0;
    else ui.dashboardAttentionSelection = end ? Math.max(0, model.meta.attentionJobIds.length - 1) : 0;
  } else if (ui.screen === 'fleet') {
    ui.selectedIndex = end ? Math.max(0, model.meta.visibleJobIds.length - 1) : 0;
  } else if (ui.screen === 'detail') {
    if (ui.detailTab === 1 && !ui.diffFile) {
      ui.diffSelection = end ? Math.max(0, model.meta.diffFiles.length - 1) : 0;
    } else if (model.meta.tabs?.[ui.detailTab] === 'Subagents' && !ui.subagentTranscriptId) {
      ui.subagentSelection = end ? Math.max(0, model.meta.subagentRowIds.length - 1) : 0;
    } else if (model.meta.tabs?.[ui.detailTab] === 'Chain') {
      ui.chainSelection = end ? Math.max(0, model.meta.chainJobIds.length - 1) : 0;
    } else {
      const { content, height, width } = detailViewport(model);
      if (content?.virtual) {
        const selection = end ? Math.max(0, (content.entries?.length || 1) - 1) : 0;
        const target = end ? virtualLogBottomPosition(content, width, height) : { entry: 0, line: 0 };
        const settled = end ? settleVirtualFollow(content, target, width, height, { selectedEntry: selection }) : { scroll: target, follow: false };
        ui.detailScroll = settled.scroll;
        ui.follow = settled.follow;
        if (ui.detailTab === 0) ui.transcriptSelection = end ? Math.max(0, (content.entries?.length || 1) - 1) : 0;
        if (ui.detailTab === 4) ui.eventSelection = selection;
      } else {
        const maxScroll = Math.max(0, (model.meta.scrollItemCount || 0) - height);
        ui.detailScroll = end ? maxScroll : 0;
      }
    }
  } else if (ui.screen === 'work') {
    ui.workScroll = end ? Math.max(0, (model.meta.scrollItemCount || 0) - Math.max(1, screen.rows - 8)) : 0;
  } else if (ui.screen === 'groups') {
    ui.groupSelection = end ? Math.max(0, (store.groups?.length || 0) - 1) : 0;
  } else if (ui.screen === 'group-members') {
    ui.groupMemberSelection = end ? Math.max(0, model.meta.visibleJobIds.length - 1) : 0;
  } else if (ui.screen === 'sessions') {
    ui.sessionSelection = end ? Math.max(0, model.meta.sessionIds.length - 1) : 0;
  } else if (ui.screen === 'providers') {
    ui.providerScroll = end ? providerScrollMax() : 0;
  } else if (ui.screen === 'stats') {
    ui.statsSelection = end ? Math.max(0, (model.meta.visibleStatsCount || 0) - 1) : 0;
  } else if (ui.screen === 'launcher') {
    ui.launcher.fieldIndex = end ? Math.max(0, model.meta.fields.length - 1) : 0;
  }
  draw();
}

function goBack() {
  if (ui.help) ui.help = false;
  else if (ui.statusHistoryOpen) ui.statusHistoryOpen = false;
  else if (ui.search) clearSearch();
  else if (ui.screen === 'fleet' && ui.filter) {
    ui.filter = '';
    ui.selectedIndex = 0;
    ui.scroll = 0;
  } else if (ui.screen === 'fleet' && ui.sessionCwdFilter) {
    ui.sessionCwdFilter = null;
    ui.sessionJobIds = null;
    ui.selectedIndex = 0;
    ui.scroll = 0;
  } else if (ui.screen === 'detail' && ui.diffFile) {
    ui.diffFile = null;
    ui.diffPaths = [];
    ui.diffWindow = null;
    ui.detailScroll = 0;
  } else if (ui.screen === 'detail' && ui.subagentTranscriptId) {
    ui.subagentTranscriptId = null;
    ui.subagentTranscriptSelection = 0;
    ui.detailScroll = 0;
    void source.selectSubagent?.(ui.jobId);
  } else if (ui.screen === 'fleet') {
    ui.screen = 'dashboard';
  } else if (ui.screen !== 'dashboard') {
    if (ui.screen === 'detail') {
      void source.selectSubagent?.(null);
      void source.selectJob(null);
      ui.screen = ui.detailReturn || 'dashboard';
    } else if (ui.screen === 'group-members') ui.screen = 'groups';
    else ui.screen = 'dashboard';
  }
  clearStatus();
  draw();
}

function switchDetailTab(tab) {
  const model = viewModel();
  const count = model.meta.tabs?.length || 5;
  const next = Math.max(0, Math.min(count - 1, tab));
  if (next === ui.detailTab) return;
  const previousName = model.meta.tabs?.[ui.detailTab];
  const nextName = model.meta.tabs?.[next];
  ui.detailTab = next;
  ui.detailScroll = 0;
  if (next === 0) ui.transcriptSelection = null;
  if (next === 4) ui.eventSelection = null;
  ui.diffFile = null;
  ui.diffPaths = [];
  ui.diffWindow = null;
  ui.chainSelection = 0;
  if (nextName !== 'Subagents') {
    ui.subagentTranscriptId = null;
    ui.subagentTranscriptSelection = 0;
  }
  clearSearch();
  draw();
  if (nextName === 'Subagents') void source.selectSubagent?.(ui.jobId);
  else if (previousName === 'Subagents') void source.selectSubagent?.(null);
}

function openPlanTab() {
  const tabs = viewModel().meta.tabs || [];
  const plan = tabs.indexOf('Plan');
  if (plan < 0) {
    setStatus('This job has no planning state', 'error');
    draw();
    return;
  }
  switchDetailTab(plan);
}

function openSubagentsTab() {
  const tabs = viewModel().meta.tabs || [];
  const subagents = tabs.indexOf('Subagents');
  if (subagents < 0) {
    setStatus('This provider has no Subagents detail surface', 'error');
    draw();
    return;
  }
  if (ui.detailTab === subagents) {
    ui.subagentTranscriptId = null;
    ui.subagentTranscriptSelection = 0;
    ui.detailScroll = 0;
    draw();
    void source.selectSubagent?.(ui.jobId);
    return;
  }
  switchDetailTab(subagents);
}

function switchWorkTab(tab) {
  const count = viewModel().meta.tabs?.length || 6;
  const next = Math.max(0, Math.min(count - 1, tab));
  if (next === ui.workTab) return;
  ui.workTab = next;
  ui.workScroll = 0;
  ui.focusedPane = 0;
  clearStatus();
  draw();
}

function handleClick(event) {
  if (event.button !== 0) return;
  const model = viewModel();
  if (ui.screen === 'detail' && event.y === model.tabs?.rect?.y) {
    const tab = tabIndexAtColumn(model.tabs.items, event.x, model.tabs.rect);
    if (tab != null) switchDetailTab(tab);
    return;
  }
  if (ui.screen === 'work' && event.y === model.tabs?.rect?.y) {
    const tab = tabIndexAtColumn(model.tabs.items, event.x, model.tabs.rect);
    if (tab != null) switchWorkTab(tab);
    return;
  }
  const pane = model.panes?.find((entry) => event.x >= entry.rect.x && event.x < entry.rect.x + entry.rect.width
    && event.y >= entry.rect.y && event.y < entry.rect.y + entry.rect.height);
  if (ui.screen === 'detail' && [0, 4].includes(ui.detailTab) && pane?.content?.virtual) {
    const contentRect = paneContentRect(pane, { scrollbar: true });
    const contentY = contentRect.y;
    const contentX = contentRect.x;
    const height = Math.max(1, contentRect.height);
    const width = Math.max(1, contentRect.width);
    if (event.x >= contentX && event.x < contentX + width && event.y >= contentY && event.y < contentY + height) {
      const index = virtualLogEntryIndexAt(pane.content, event.y - contentY, width, height);
      if (index != null) {
        const field = ui.detailTab === 0 ? 'transcriptSelection' : 'eventSelection';
        ui[field] = index;
        const target = virtualLogScrollToEntry(pane.content, index, width, height);
        const settled = settleVirtualFollow(pane.content, target, width, height, { selectedEntry: index });
        ui.detailScroll = settled.scroll;
        ui.follow = settled.follow;
        if (ui.detailTab === 0) {
          const block = pane.content.entries[index];
          if (!toggleToolBlock(block)) draw();
        } else draw();
      }
    }
    return;
  }
  if (ui.screen === 'detail' && model.meta.tabs?.[ui.detailTab] === 'Chain' && pane?.content?.kind === 'key-value') {
    const section = keyValueSectionIndexAt(pane, event.x, event.y);
    if (section != null) {
      ui.chainSelection = section;
      draw();
    }
    return;
  }
  const row = tableRowIndexAt(pane, event.x, event.y);
  if (row == null) return;
  if (ui.screen === 'dashboard') {
    if (pane?.title === 'Needs you') { ui.dashboardFocus = 0; ui.dashboardAttentionSelection = row; }
    else if (pane?.title === 'Recent notable activity') { ui.dashboardFocus = 1; ui.dashboardFeedSelection = row; }
  } else if (ui.screen === 'fleet') ui.selectedIndex = row;
  else if (ui.screen === 'groups') ui.groupSelection = row;
  else if (ui.screen === 'group-members') ui.groupMemberSelection = row;
  else if (ui.screen === 'sessions') ui.sessionSelection = row;
  else if (ui.screen === 'stats') ui.statsSelection = row;
  else if (ui.screen === 'launcher') ui.launcher.fieldIndex = row;
  else if (ui.screen === 'detail' && ui.detailTab === 1 && !ui.diffFile) ui.diffSelection = row;
  else if (ui.screen === 'detail' && model.meta.tabs?.[ui.detailTab] === 'Subagents' && !ui.subagentTranscriptId) ui.subagentSelection = row;
  else if (ui.screen === 'detail' && model.meta.tabs?.[ui.detailTab] === 'Chain') ui.chainSelection = row;
  draw();
}

function toggleNotifications() {
  const enabled = notifier.toggle();
  ui.notifyEnabled = notifier.enabled;
  persistPreferences();
  setStatus(String(process.env.DELEGATE_TUI_NOTIFY ?? '1') === '0'
    ? 'Notifications are disabled by DELEGATE_TUI_NOTIFY=0'
    : `Notifications ${enabled ? 'enabled' : 'disabled'} for this session`);
  draw();
}

function toggleTimestamps(migration = false) {
  ui.timestampMode = ui.timestampMode === 'relative' ? 'absolute' : 'relative';
  invalidateWrapCache();
  persistPreferences();
  setStatus(`Timestamps: ${ui.timestampMode}${migration ? '; Stats moved to g t' : ''}`);
  draw();
}

function toggleTranscriptAnomalies() {
  if (ui.screen !== 'detail' || ui.detailTab !== 0) return false;
  const count = Number(viewModel().meta?.anomalyCount || 0);
  if (!count) {
    setStatus('No transcript anomalies to show', 'error');
    draw();
    return false;
  }
  ui.transcriptAnomaliesOnly = !ui.transcriptAnomaliesOnly;
  ui.transcriptKindFilter = null;
  ui.follow = false;
  ui.detailScroll = 0;
  ui.transcriptSelection = 0;
  clearSearch();
  setStatus(ui.transcriptAnomaliesOnly
    ? `Showing ${count} transcript anomalies`
    : 'Showing the complete transcript');
  draw();
  return true;
}

function toggleTranscriptKind(kind) {
  if (ui.screen !== 'detail' || ui.detailTab !== 0) return false;
  const countKey = kind === 'subagents' ? 'subagentCount' : 'toolCount';
  const count = Number(viewModel().meta?.[countKey] || 0);
  if (!count) {
    setStatus(`No transcript ${kind} to show`, 'error');
    draw();
    return false;
  }
  ui.transcriptKindFilter = ui.transcriptKindFilter === kind ? null : kind;
  ui.transcriptAnomaliesOnly = false;
  ui.follow = false;
  ui.detailScroll = 0;
  ui.transcriptSelection = 0;
  clearSearch();
  setStatus(ui.transcriptKindFilter
    ? `Showing ${count} transcript ${kind}`
    : 'Showing the complete transcript');
  draw();
  return true;
}

function openSelectedSubagent() {
  if (ui.screen !== 'detail' || viewModel().meta.tabs?.[ui.detailTab] !== 'Subagents' || ui.subagentTranscriptId) return false;
  const model = viewModel();
  const row = model.meta.subagentRows?.[ui.subagentSelection];
  if (!row) {
    setStatus('No subagent row is selected', 'error');
    draw();
    return false;
  }
  if (row.category === 'guardians') {
    ui.guardiansExpanded = !ui.guardiansExpanded;
    ui.detailScroll = 0;
    setStatus(`Guardians ${ui.guardiansExpanded ? 'expanded' : 'collapsed'}`);
    draw();
    return true;
  }
  ui.subagentTranscriptId = row.id;
  ui.subagentTranscriptSelection = 0;
  ui.detailScroll = 0;
  clearSearch();
  setStatus(row.transcript === 'Unavailable'
    ? 'Opening the explicit unavailable transcript explanation'
    : `Opening the child transcript for ${row.agentName || row.id}`);
  draw();
  void source.selectSubagent?.(ui.jobId, row.id);
  return true;
}

function toggleEventCategory(category) {
  if (ui.screen !== 'detail' || ui.detailTab !== 4) return false;
  const count = Number(viewModel().meta?.[`${category}Count`] || 0);
  if (!count) {
    setStatus(`No ${category} events to show`, 'error');
    draw();
    return false;
  }
  ui.eventCategoryFilter = ui.eventCategoryFilter === category ? null : category;
  ui.follow = false;
  ui.detailScroll = 0;
  ui.eventSelection = 0;
  clearSearch();
  setStatus(ui.eventCategoryFilter
    ? `Showing ${count} ${category} events`
    : 'Showing all events');
  draw();
  return true;
}

function openScopeEvidence() {
  if (ui.screen !== 'detail' || Number(viewModel().meta?.scopeViolationCount || 0) <= 0) return false;
  switchDetailTab(2);
  return true;
}

function toggleFollow() {
  if (ui.screen !== 'detail' || ![0, 4].includes(ui.detailTab)) return false;
  if (ui.follow) {
    const model = viewModel();
    const { content, height, width } = detailViewport(model);
    ui.detailScroll = content?.virtual ? virtualLogBottomPosition(content, width, height) : ui.detailScroll;
    ui.follow = false;
  } else {
    ui.follow = true;
  }
  draw();
  return true;
}

function navigateScreen(target) {
  if (target === 'launcher' && ui.remote?.enabled && !ui.remote?.includeLocal) {
    setStatus('read-only remote: launcher is unavailable', 'error');
    draw();
    return false;
  }
  if (ui.screen === 'detail') void source.selectJob(null);
  ui.screen = target;
  if (target === 'fleet') {
    ui.selectedIndex = 0;
    ui.sessionCwdFilter = null;
    ui.sessionJobIds = null;
  }
  if (target === 'work') {
    ui.workIndex = 0;
    ui.workTab = 0;
    ui.workScroll = 0;
  }
  if (target === 'groups') ui.groupSelection = 0;
  if (target === 'sessions') {
    ui.sessionSelection = 0;
    ui.sessionScroll = 0;
  }
  if (target === 'launcher') {
    const enabled = choiceValues('provider');
    if (!enabled.includes(ui.launcher.provider)) ui.launcher.provider = enabled[0];
    updateRouteAdvice();
  }
  clearStatus();
  draw();
  return true;
}

function clearGPrefix() {
  if (gPrefixTimer) clearTimeout(gPrefixTimer);
  gPrefixTimer = null;
  ui.gPrefix = false;
  ui.gPrefixHelp = false;
}

function armGPrefix() {
  clearGPrefix();
  ui.gPrefix = true;
  gPrefixTimer = setTimeout(() => {
    gPrefixTimer = null;
    if (!ui.gPrefix || quitting) return;
    ui.gPrefixHelp = true;
    draw();
  }, 300);
  gPrefixTimer.unref?.();
}

function consumeGPrefix(key) {
  if (!ui.gPrefix) return false;
  const targets = { w: 'work', f: 'fleet', r: 'groups', s: 'sessions', p: 'providers', t: 'stats', l: 'launcher' };
  const target = targets[key];
  clearGPrefix();
  if (!target) return false;
  navigateScreen(target);
  return true;
}

function openActionMenu() {
  ui.actionMenu = {
    query: '',
    filtering: false,
    selection: 0,
    hint: ui.screen === 'fleet'
      ? 'x now opens actions; external-thread visibility lives here'
      : 'Unavailable actions stay visible with their reason'
  };
  setStatus(ui.actionMenu.hint);
  draw();
}

function actionMenuItems() {
  return actionMenuForContext(currentKeymapContext(), ui.actionMenu?.query || '');
}

function dispatchMenuAction(action) {
  ui.actionMenu = null;
  if (action === 'detail.steer') return detailAction('s');
  if (action === 'detail.answer') return detailAction('a');
  if (action === 'detail.resume') return detailAction('r');
  if (action === 'detail.release') return detailAction('R');
  if (action === 'detail.review') return detailAction('w');
  if (action === 'detail.nudge') return detailAction('n');
  if (action === 'work.accept') return workAction('a');
  if (action === 'work.integrate') return workAction('i');
  if (action === 'work.next-round') return workAction('w');
  if (action === 'fleet.externals') {
    ui.showExternals = !ui.showExternals;
    ui.selectedIndex = 0;
    setStatus(`External threads ${ui.showExternals ? 'shown' : 'hidden'}`);
    draw();
    return;
  }
  if (action === 'fleet.active') {
    ui.activeOnly = !ui.activeOnly;
    ui.selectedIndex = 0;
    draw();
    return;
  }
  if (action === 'fleet.sort') {
    const sorts = ['activity', 'recency', 'provider', 'tokens'];
    ui.fleetSort = sorts[(sorts.indexOf(ui.fleetSort) + 1) % sorts.length];
    ui.selectedIndex = 0;
    draw();
    return;
  }
  if (action === 'fleet.density') {
    ui.fleetDensity = ui.fleetDensity === 'compact' ? 'wide' : 'compact';
    persistPreferences();
    draw();
    return;
  }
  if (action === 'detail.follow') return toggleFollow();
  if (action === 'detail.anomalies') return toggleTranscriptAnomalies();
  if (action === 'detail.tools') return toggleTranscriptKind('tools');
  if (action === 'detail.subagents') return openSubagentsTab();
  if (action === 'detail.event-errors') return toggleEventCategory('error');
  if (action === 'detail.event-warnings') return toggleEventCategory('warning');
  if (action === 'detail.events') return jumpTranscriptToEvents();
  if (action === 'detail.diff') return openFocusedToolDiff();
  if (action === 'detail.scope-evidence') return openScopeEvidence();
  if (action === 'detail.plan') return openPlanTab();
  if (action === 'launcher.editor') return editLauncherBody();
  if (action === 'launcher.dry-run') return dryRunLaunch();
  if (action === 'view.yank') return copyFocused();
  if (action === 'view.timestamps') return toggleTimestamps();
  if (action === 'view.notifications') return toggleNotifications();
  if (action === 'diagnostic.status-history') {
    ui.statusHistoryOpen = true;
    ui.statusHistoryPage = 0;
    draw();
  }
}

function dispatchRegisteredBinding(binding) {
  return dispatchKeymapBinding(binding, {
    perform(action) {
      dispatchMenuAction(action);
    },
    confirm(gate, item) {
      ui.actionMenu = null;
      if (gate !== 'job-id-suffix') {
        setStatus(`Unsupported confirmation gate for ${item.action}`, 'error');
        draw();
        return;
      }
      if (item.action === 'detail.cancel') beginCancel(selectedJob());
      else if (item.action === 'detail.revert') beginRevert(selectedJob());
      else if (item.action === 'work.reject') beginWorkDecision('rejected');
      else {
        setStatus(`No confirmation route is registered for ${item.action}`, 'error');
        draw();
      }
    },
    missingConfirmation(item) {
      ui.actionMenu = null;
      setStatus(`Blocked destructive action without confirmation: ${item.action}`, 'error');
      draw();
    }
  });
}

function handleActionMenu(key) {
  const menu = ui.actionMenu;
  if (!menu) return false;
  if (key && typeof key === 'object' && key.type === 'paste') {
    if (menu.filtering) {
      menu.query += String(key.text || '');
      menu.selection = 0;
      draw();
    }
    return true;
  }
  if (key === 'escape' || (key === 'x' && !menu.filtering)) {
    ui.actionMenu = null;
    clearStatus();
    draw();
    return true;
  }
  if (key === '/') {
    menu.filtering = true;
    menu.query = '';
    menu.selection = 0;
    draw();
    return true;
  }
  if (menu.filtering) {
    if (key === 'enter') {
      menu.filtering = false;
      draw();
    } else if (key === 'backspace') {
      const graphemes = splitGraphemes(menu.query);
      graphemes.pop();
      menu.query = graphemes.join('');
      menu.selection = 0;
      draw();
    } else if (key === 'ctrl-u') {
      menu.query = '';
      menu.selection = 0;
      draw();
    } else if (typeof key === 'string' && key.length && !/[\u0000-\u001f\u007f]/.test(key)) {
      menu.query += key;
      menu.selection = 0;
      draw();
    }
    return true;
  }
  const items = actionMenuItems();
  if (key === 'up' || key === 'k') menu.selection = Math.max(0, menu.selection - 1);
  else if (key === 'down' || key === 'j') menu.selection = Math.min(Math.max(0, items.length - 1), menu.selection + 1);
  else if (key === 'home' || key === 'g') menu.selection = 0;
  else if (key === 'end' || key === 'G') menu.selection = Math.max(0, items.length - 1);
  else if (key === 'enter') {
    const selected = items[menu.selection];
    if (!selected) return true;
    if (selected.unavailable) {
      menu.hint = selected.unavailable;
      setStatus(selected.unavailable, 'error');
      draw();
      return true;
    }
    if (selected.class === 'destructive') dispatchRegisteredBinding(selected);
    else dispatchMenuAction(selected.action);
    return true;
  } else return true;
  draw();
  return true;
}

function handleHelp(key) {
  if (!ui.help) return false;
  if (key === '?' || key === 'escape') {
    ui.help = false;
    ui.helpPage = 0;
    draw();
    return true;
  }
  const pages = viewModel().overlay?.pages || [];
  if (['down', 'j', ']', 'page-down', 'ctrl-d'].includes(key)) ui.helpPage = Math.min(Math.max(0, pages.length - 1), ui.helpPage + 1);
  else if (['up', 'k', '[', 'page-up', 'ctrl-u'].includes(key)) ui.helpPage = Math.max(0, ui.helpPage - 1);
  draw();
  return true;
}

function handleKey(key) {
  if (key === 'focus-out') {
    ui.terminalFocused = false;
    spinnerAnimator.setActive(false);
    return;
  }
  if (key === 'focus-in') {
    ui.terminalFocused = true;
    draw();
    return;
  }
  const binding = typeof key === 'string' ? resolveKeymapAction(key, currentKeymapContext()) : null;
  if (binding?.action === 'app.quit') return quit(0);
  if (binding?.action === 'diagnostic.mark') {
    const marker = screen.markDiagnostic();
    setStatus(marker ? `Diagnostic marker saved at frame ${marker.frame}` : 'Diagnostic recorder is not enabled', marker ? 'info' : 'error');
    draw();
    return;
  }
  if (ui.input || ui.confirm) return editValue(key);
  if (ui.actionMenu) return handleActionMenu(key);
  if (ui.help) return handleHelp(key);
  if (ui.statusHistoryOpen) {
    const pages = viewModel().overlay?.pages || [];
    if (key === 'M' || key === 'escape') ui.statusHistoryOpen = false;
    else if (['down', 'j', ']', 'page-down', 'ctrl-d'].includes(key)) ui.statusHistoryPage = Math.min(Math.max(0, pages.length - 1), ui.statusHistoryPage + 1);
    else if (['up', 'k', '[', 'page-up', 'ctrl-u'].includes(key)) ui.statusHistoryPage = Math.max(0, ui.statusHistoryPage - 1);
    draw();
    return;
  }
  if (key && typeof key === 'object' && key.type === 'scroll') return move(key.delta);
  if (key && typeof key === 'object' && key.type === 'click') return handleClick(key);
  if (consumeGPrefix(key)) return;
  if (key === '?') { ui.help = true; ui.helpPage = 0; draw(); return; }
  if (key === 'x') { openActionMenu(); return; }
  if (key === 'M') { ui.statusHistoryOpen = true; ui.statusHistoryPage = 0; draw(); return; }
  if (key === 'escape') return goBack();
  if (key === 'n' || key === 'N') {
    if (ui.search?.query && jumpSearch(key === 'n' ? 1 : -1)) return;
    setStatus(key === 'N'
      ? 'N is previous match; no active search. Launcher moved to g l'
      : 'n is next match; no active search. Nudge moved to x actions');
    draw();
    return;
  }
  const blocked = remoteActionMessage(ui, key, selectedJob());
  if (blocked) {
    setStatus(blocked, 'error');
    draw();
    return;
  }
  const directBlocked = directTransportActionMessage(ui, key, selectedJob());
  if (directBlocked) {
    setStatus(directBlocked, 'error');
    draw();
    return;
  }
  if (binding?.class === 'destructive') {
    dispatchRegisteredBinding(binding);
    return;
  }
  if (binding?.action === 'detail.plan') {
    dispatchRegisteredBinding(binding);
    return;
  }
  if (key === 'b') return toggleNotifications();
  if (key === 'T') return toggleTimestamps();
  if (key === 't') return toggleTimestamps(true);
  if (key === 'y') {
    const copied = copyFocused();
    if (ui.screen === 'launcher') {
      setStatus(`${copied ? 'Yanked focused launcher value; ' : ''}launch moved to d dry-run confirmation`);
      draw();
    }
    return;
  }
  if (key === 'up' || key === 'k') return move(-1, { select: true });
  if (key === 'down' || key === 'j') return move(1, { select: true });
  if (key === 'page-up' || key === 'ctrl-u') return page(-1);
  if (key === 'page-down' || key === 'ctrl-d') return page(1);
  if (key === 'home') return moveEdge(false);
  if (key === 'g') {
    armGPrefix();
    moveEdge(false);
    return;
  }
  if (key === 'end') return moveEdge(true);
  if (key === 'G') {
    moveEdge(true);
    setStatus('G now goes to bottom; Groups moved to g r');
    draw();
    return;
  }
  if (key === 'tab' || key === 'shift-tab') {
    if (ui.screen === 'dashboard') ui.dashboardFocus = ui.dashboardFocus === 0 ? 1 : 0;
    else {
      const count = Math.max(1, viewModel().panes?.filter((pane) => pane.focusable !== false).length || 1);
      ui.focusedPane = (ui.focusedPane + (key === 'tab' ? 1 : -1) + count) % count;
    }
    draw();
    return;
  }
  if (key === 'F') {
    navigateScreen('fleet');
    return;
  }
  if (key === 'S') {
    setStatus('Sessions moved to g s');
    draw();
    return;
  }
  if (key === 'p') {
    setStatus('Providers moved to g p');
    draw();
    return;
  }
  if (ui.screen === 'dashboard') {
    if (key === 'enter') {
      const job = selectedJob();
      if (job) openJobDetail(job, 'dashboard');
    }
    return;
  }
  if (ui.screen === 'groups') {
    if (key === 'enter') {
      const id = viewModel().meta.selectedGroupId;
      if (id) {
        ui.groupId = id;
        ui.groupMemberSelection = 0;
        ui.groupMemberScroll = 0;
        ui.screen = 'group-members';
        clearStatus();
        draw();
      }
    }
    return;
  }
  if (ui.screen === 'group-members') {
    if (key === '/') { beginInput('fleet-filter', 'Filter id/model/cwd', ui.filter); return; }
    if (key === 'enter') openJobDetail(selectedJob(), 'group-members');
    return;
  }
  if (ui.screen === 'work') {
    if (/^[1-6]$/.test(key)) {
      switchWorkTab(Number(key) - 1);
      return;
    }
    if (key === '[' || key === ']') {
      const count = viewModel().meta.tabs?.length || 6;
      switchWorkTab((ui.workTab + (key === ']' ? 1 : -1) + count) % count);
      return;
    }
    if (key === 'left' || key === 'right') {
      const count = viewModel().meta.workItemCount || 0;
      if (count > 1) {
        ui.workIndex = (ui.workIndex + (key === 'right' ? 1 : -1) + count) % count;
        ui.workScroll = 0;
        clearStatus();
        draw();
      }
      return;
    }
    if (['a', 'i', 'w'].includes(key)) workAction(key);
    return;
  }
  if (ui.screen === 'stats') {
    if (key === '/') { beginInput('stats-filter', 'Filter loaded audit rows', ui.statsFilter); return; }
    return;
  }
  if (ui.screen === 'sessions') {
    if (key === 'enter') {
      const session = viewModel().meta;
      const cwd = session.selectedSessionCwd;
      if (cwd) {
        ui.filter = '';
        ui.sessionCwdFilter = cwd;
        ui.sessionJobIds = session.selectedActiveJobIds || [];
        ui.selectedIndex = 0;
        ui.scroll = 0;
        ui.screen = 'fleet';
        setStatus(`Fleet showing active jobs for coordinator cwd: ${cwd}`);
        draw();
      }
    }
    return;
  }
  if (ui.screen === 'fleet') {
    if (key === 'a') { ui.activeOnly = !ui.activeOnly; ui.selectedIndex = 0; draw(); return; }
    if (key === 'o') {
      const sorts = ['activity', 'recency', 'provider', 'tokens'];
      ui.fleetSort = sorts[(sorts.indexOf(ui.fleetSort) + 1) % sorts.length];
      ui.selectedIndex = 0;
      draw();
      return;
    }
    if (key === 'z') {
      ui.fleetDensity = ui.fleetDensity === 'compact' ? 'wide' : 'compact';
      persistPreferences();
      draw();
      return;
    }
    if (key === '/') { beginInput('fleet-filter', 'Filter id/model/cwd', ui.filter); return; }
    if (key === 'enter') {
      const job = selectedJob();
      if (job) {
        openJobDetail(job, 'fleet');
      }
    }
    return;
  }
  if (ui.screen === 'launcher') {
    if (key === 'enter') editLauncherField();
    else if (key === 'left') cycleLauncher(-1);
    else if (key === 'right') cycleLauncher(1);
    else if (key === 'd') dryRunLaunch();
    else if (key === 'e') editLauncherBody();
    return;
  }
  if (ui.screen !== 'detail') return;
  if (/^[1-6]$/.test(key)) {
    switchDetailTab(Number(key) - 1); return;
  }
  if (key === '[' || key === ']') {
    const count = viewModel().meta.tabs?.length || 5;
    switchDetailTab((ui.detailTab + (key === ']' ? 1 : -1) + count) % count);
    return;
  }
  if (key === 'f' && [0, 4].includes(ui.detailTab)) {
    toggleFollow();
    return;
  }
  if (key === 'A' && ui.detailTab === 0) { toggleTranscriptAnomalies(); return; }
  if (key === 'O' && ui.detailTab === 0) { toggleTranscriptKind('tools'); return; }
  if (key === 'U') { openSubagentsTab(); return; }
  if (key === 'A' && ui.detailTab === 4) { toggleEventCategory('error'); return; }
  if (key === 'W' && ui.detailTab === 4) { toggleEventCategory('warning'); return; }
  if (key === '/' && [0, 1, 4].includes(ui.detailTab)) { beginPaneSearch(); return; }
  if (key === 'E' && ui.detailTab === 0) { jumpTranscriptToEvents(); return; }
  if (key === 'enter' && ui.detailTab === 0 && toggleFocusedTool()) return;
  if (key === 'enter' && ui.detailTab === 4 && toggleFocusedEvent()) return;
  if (key === 'd' && ui.detailTab === 0 && openFocusedToolDiff()) return;
  if (key === 'enter' && ui.detailTab === 1 && !ui.diffFile) { openDiffFile(); return; }
  if (key === 'enter' && viewModel().meta.tabs?.[ui.detailTab] === 'Subagents' && !ui.subagentTranscriptId) {
    openSelectedSubagent();
    return;
  }
  if (key === 'enter' && viewModel().meta.tabs?.[ui.detailTab] === 'Chain') {
    const id = viewModel().meta.chainJobIds?.[ui.chainSelection];
    const job = store.jobs.find((entry) => entry.id === id);
    if (job) openJobDetail(job, ui.detailReturn);
    return;
  }
  if (key === 'left' && ui.detailTab === 1) { pageDiff(-1); return; }
  if (key === 'right' && ui.detailTab === 1) { pageDiff(1); return; }
  if (['a', 's', 'r', 'R', 'w'].includes(key)) detailAction(key);
}

function onData(buffer) {
  if (pendingInputAtNs == null) pendingInputAtNs = process.hrtime.bigint().toString();
  bufferedInput.push(buffer);
}

function attachTuiInput() {
  if (widthProbeInputStage) widthProbeInputStage.attach(onData);
  else process.stdin.on('data', onData);
}

function detachTuiInput() {
  if (widthProbeInputStage) widthProbeInputStage.detach(onData);
  else process.stdin.off('data', onData);
}

const bufferedInput = new BufferedInput({
  onFlush(events) {
    activeInputTiming = {
      id: `input-${diagnosticRecorder?.frame ?? 0}-${Date.now()}`,
      atNs: pendingInputAtNs || process.hrtime.bigint().toString(),
      events: events.length
    };
    pendingInputAtNs = null;
    diagnosticRecorder?.recordTimeline('input.flush', {
      inputId: activeInputTiming.id,
      inputAtNs: activeInputTiming.atNs,
      events: events.length
    });
    inputBatch = true;
    inputDrawPending = false;
    try {
      for (const event of events) handleKey(event);
    } finally {
      inputBatch = false;
      if (inputDrawPending) draw('input');
      activeInputTiming = null;
    }
  }
});

source.on('change', (next) => {
  store = next;
  ui.remote = next.remote || null;
  notifier.observe(next);
  rebuildPaneSearch();
  if (ui.screen === 'launcher') scheduleRouteAdvice();
  draw('data');
});
source.on('warning', (error) => { setStatus(`Store warning: ${error.message}`, 'error'); draw('data-warning'); });
screen.on('resize', () => { invalidateWrapCache(); draw('resize'); });
const clock = setInterval(() => {
  ui.now = Date.now();
  if (ui.terminalFocused) draw('clock');
}, 1000);
clock.unref?.();

screen.start();
const probeResult = await probeTerminalWidths({
  screen, input: process.stdin, env: process.env, mode: widthProbeMode(process.env), cached: cachedWidths,
  onBackgroundComplete(result) {
    if (quitting) return;
    let redraw = false;
    if (result.source === 'probe' && Object.keys(result.widths).length) {
      configureGlyphs({ env: process.env, widths: result.widths });
      widthProbeCache[widthIdentity] = { widths: result.widths, measuredAt: Date.now() };
      persistPreferences();
      invalidateWrapCache();
      redraw = true;
    }
    if (result.mode === 'verbose') {
      addStatusHistory(formatWidthProbeResult(result), 'info');
      redraw = true;
    }
    if (redraw) draw();
  }
});
configureGlyphs({ env: process.env, widths: probeResult.widths });
if (probeResult.source === 'probe' && Object.keys(probeResult.widths).length) {
  widthProbeCache[widthIdentity] = { widths: probeResult.widths, measuredAt: Date.now() };
  persistPreferences();
}
if (probeResult.mode === 'verbose') addStatusHistory(formatWidthProbeResult(probeResult), 'info');
widthProbeInputStage = probeResult.background || null;
attachTuiInput();
if (probeResult.remainder) bufferedInput.push(probeResult.remainder);
draw('startup');
if (widthProbeInputStage) {
  const stage = widthProbeInputStage;
  void stage.released.then(() => { if (widthProbeInputStage === stage) widthProbeInputStage = null; });
}
if (initialJobId) void source.selectJob(initialJobId);
