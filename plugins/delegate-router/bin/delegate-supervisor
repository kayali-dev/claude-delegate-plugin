#!/usr/bin/env node
import crypto from 'node:crypto';
import fs from 'node:fs';
import net from 'node:net';
import path from 'node:path';
import { spawn } from 'node:child_process';
import { fileURLToPath } from 'node:url';
import { isProcessAlive } from './lib/process.mjs';
import {
  SUPERVISOR_PROTOCOL_VERSION,
  classifySupervisorLock,
  ensureSupervisorDirectories,
  listSupervisorLeases,
  readPrivateJson,
  supervisorBrokerVersion,
  supervisorPaths,
  versionSkewDecision
} from './lib/supervisor-common.mjs';

const self = fileURLToPath(import.meta.url);
const brokerVersion = supervisorBrokerVersion();
const jsonOutput = process.argv.includes('--json');

function output(value, status = 0) {
  const line = JSON.stringify(value);
  if (jsonOutput) process.stdout.write(`${line}\n`);
  else if (value.ok === false) process.stderr.write(`delegate-supervisor: ${value.error || value.reason || value.code}\n`);
  else process.stdout.write(`${line}\n`);
  process.exitCode = status;
}

function wait(ms) {
  return new Promise((resolve) => setTimeout(resolve, ms));
}

function requestResident(method, params = {}, options = {}) {
  const locations = supervisorPaths();
  const request = {
    requestId: crypto.randomUUID(),
    method,
    params,
    protocolVersion: options.protocolVersion ?? SUPERVISOR_PROTOCOL_VERSION,
    brokerVersion: options.brokerVersion ?? brokerVersion
  };
  const timeoutMs = Number(options.timeoutMs || 2000);
  return new Promise((resolve, reject) => {
    const socket = net.createConnection(locations.socket);
    let settled = false;
    let body = '';
    const finish = (error, value) => {
      if (settled) return;
      settled = true;
      clearTimeout(timer);
      socket.destroy();
      if (error) reject(error);
      else resolve(value);
    };
    const timer = setTimeout(() => {
      const error = new Error('supervisor control request timed out');
      error.code = 'SUPERVISOR_UNRESPONSIVE';
      finish(error);
    }, timeoutMs);
    timer.unref?.();
    socket.setEncoding('utf8');
    socket.once('connect', () => socket.write(`${JSON.stringify(request)}\n`));
    socket.on('data', (chunk) => {
      body += chunk;
      const newline = body.indexOf('\n');
      if (newline < 0) return;
      try { finish(null, JSON.parse(body.slice(0, newline))); }
      catch (error) { finish(error); }
    });
    socket.once('error', (error) => finish(error));
    socket.once('end', () => {
      if (!settled) {
        const error = new Error('supervisor closed the control channel without a response');
        error.code = 'SUPERVISOR_UNRESPONSIVE';
        finish(error);
      }
    });
  });
}

async function acquireStartupLock() {
  const locations = ensureSupervisorDirectories();
  const deadline = Date.now() + 5000;
  for (;;) {
    try {
      const fd = fs.openSync(locations.startupLock, 'wx', 0o600);
      fs.writeFileSync(fd, `${JSON.stringify({ pid: process.pid, at: Date.now() })}\n`);
      return () => {
        try { fs.closeSync(fd); } catch {}
        try { fs.unlinkSync(locations.startupLock); } catch {}
      };
    } catch (error) {
      if (error.code !== 'EEXIST') throw error;
      let owner = null;
      try { owner = JSON.parse(fs.readFileSync(locations.startupLock, 'utf8')); } catch {}
      if (!owner?.pid || !isProcessAlive(owner.pid)) {
        try { fs.unlinkSync(locations.startupLock); } catch {}
        continue;
      }
      if (Date.now() >= deadline) {
        const timeout = new Error('timed out waiting for concurrent supervisor startup');
        timeout.code = 'SUPERVISOR_START_TIMEOUT';
        throw timeout;
      }
      await wait(25);
    }
  }
}

async function waitUntilGone(pid, timeoutMs = 4000) {
  const deadline = Date.now() + timeoutMs;
  while (Date.now() < deadline) {
    if (!isProcessAlive(pid)) return true;
    await wait(25);
  }
  return !isProcessAlive(pid);
}

function removeGoneInstanceFiles(lock) {
  const locations = supervisorPaths();
  if (lock?.pid && isProcessAlive(lock.pid)) return false;
  try { fs.unlinkSync(locations.lock); } catch {}
  try { fs.unlinkSync(locations.socket); } catch {}
  return true;
}

async function resolveExisting() {
  let status = null;
  try { status = await requestResident('status'); } catch {}
  if (status?.ok) {
    const decision = versionSkewDecision(status);
    if (decision === 'compatible') return { ready: true, status, reused: true };
    if (decision === 'fallback-live-leases') {
      return {
        ready: false,
        code: 'VERSION_SKEW_LIVE_LEASES',
        reason: `resident ${status.brokerVersion}/p${status.protocolVersion} holds ${status.liveLeases} live lease(s)`
      };
    }
    const drained = await requestResident('drain', { reason: 'version-skew-restart' }, {
      protocolVersion: status.protocolVersion,
      brokerVersion: status.brokerVersion
    }).catch(() => null);
    if (!drained?.ok) {
      return { ready: false, code: 'VERSION_SKEW_DRAIN_FAILED', reason: 'incompatible resident did not accept a clean drain' };
    }
    if (!await waitUntilGone(status.pid)) {
      return { ready: false, code: 'VERSION_SKEW_DRAIN_TIMEOUT', reason: 'incompatible resident did not exit after draining' };
    }
    removeGoneInstanceFiles(status);
    return { ready: false, start: true };
  }

  const locations = supervisorPaths();
  const lock = readPrivateJson(locations.lock);
  if (!lock) return { ready: false, start: true };
  const classification = classifySupervisorLock(lock, {
    liveLeases: listSupervisorLeases().filter((lease) => isProcessAlive(lease.pid)).length
  });
  if (classification.action === 'reclaim-files-only') {
    removeGoneInstanceFiles(lock);
    return { ready: false, start: true };
  }
  if (classification.action === 'request-clean-stop') {
    // A live but unresponsive PID is signalled only after its command line and
    // boot id positively identify it as this supervisor. SIGKILL is never used.
    try { process.kill(lock.pid, 'SIGTERM'); } catch {}
    if (await waitUntilGone(lock.pid)) {
      removeGoneInstanceFiles(lock);
      return { ready: false, start: true };
    }
    return { ready: false, code: 'SUPERVISOR_UNRESPONSIVE', reason: 'identified resident did not exit after a clean stop request' };
  }
  return {
    ready: false,
    code: classification.action === 'leave-live-leases' ? 'SUPERVISOR_UNRESPONSIVE_LIVE_LEASES' : 'SUPERVISOR_IDENTITY_UNKNOWN',
    reason: classification.action === 'leave-live-leases'
      ? 'resident is unresponsive and still owns live leases'
      : 'lock PID is alive but is not positively identified as a delegate supervisor'
  };
}

async function spawnBootstrap() {
  const bootId = crypto.randomUUID();
  const child = spawn(process.execPath, [self, '--bootstrap', '--boot-id', bootId], {
    cwd: '/',
    detached: true,
    stdio: 'ignore',
    windowsHide: true,
    env: process.env
  });
  child.unref();
  const deadline = Date.now() + Number(process.env.DELEGATE_SUPERVISOR_START_TIMEOUT_MS || 5000);
  while (Date.now() < deadline) {
    await wait(25);
    try {
      const status = await requestResident('status', {}, { timeoutMs: 500 });
      if (status?.ok && status.bootId === bootId && versionSkewDecision(status) === 'compatible') {
        return { ready: true, status, reused: false };
      }
      if (status?.ok && status.bootId !== bootId) {
        const decision = versionSkewDecision(status);
        if (decision === 'compatible') return { ready: true, status, reused: true };
      }
    } catch {}
  }
  const error = new Error('supervisor did not become ready before the startup deadline');
  error.code = 'SUPERVISOR_START_TIMEOUT';
  throw error;
}

async function ensureResident() {
  if (process.env.DELEGATE_SUPERVISOR === '0') {
    return { ready: false, code: 'SUPERVISOR_DISABLED', reason: 'disabled by DELEGATE_SUPERVISOR=0' };
  }
  const existing = await resolveExisting();
  if (existing.ready || !existing.start) return existing;
  const release = await acquireStartupLock();
  try {
    const second = await resolveExisting();
    if (second.ready || !second.start) return second;
    return await spawnBootstrap();
  } finally {
    release();
  }
}

async function bootstrap(bootId) {
  const locations = ensureSupervisorDirectories();
  const stdout = fs.openSync(locations.stdout, 'a', 0o600);
  const stderr = fs.openSync(locations.stderr, 'a', 0o600);
  try {
    const child = spawn(process.execPath, [self, '--serve', '--boot-id', bootId], {
      cwd: '/',
      detached: true,
      stdio: ['ignore', stdout, stderr],
      windowsHide: true,
      env: process.env
    });
    child.unref();
  } finally {
    fs.closeSync(stdout);
    fs.closeSync(stderr);
  }
}

async function serve(bootId) {
  const { ResidentSupervisor } = await import('./lib/supervisor-runtime.mjs');
  const resident = new ResidentSupervisor({ bootId, exitOnShutdown: true });
  await resident.start();
}

function argumentAfter(flag) {
  const index = process.argv.indexOf(flag);
  return index >= 0 ? process.argv[index + 1] : null;
}

async function main() {
  if (process.argv.includes('--bootstrap')) {
    await bootstrap(argumentAfter('--boot-id') || crypto.randomUUID());
    return;
  }
  if (process.argv.includes('--serve')) {
    await serve(argumentAfter('--boot-id') || crypto.randomUUID());
    return;
  }
  const args = process.argv.slice(2).filter((arg) => arg !== '--json');
  const command = args[0] || 'status';
  if (['--help', '-h', 'help'].includes(command)) {
    process.stdout.write('Usage: delegate-supervisor start|status|drain|submit <job-id> [--json]\n');
    return;
  }
  if (command === 'start') {
    const result = await ensureResident();
    output(result.ready ? { ok: true, ...result.status, reused: result.reused } : { ok: false, code: result.code, reason: result.reason }, result.ready ? 0 : 1);
    return;
  }
  if (command === 'status') {
    try { output(await requestResident('status')); }
    catch (error) { output({ ok: false, code: error.code || 'SUPERVISOR_UNAVAILABLE', error: error.message }, 1); }
    return;
  }
  if (command === 'drain') {
    try {
      const status = await requestResident('status');
      output(await requestResident('drain', { reason: 'cli' }, {
        protocolVersion: status.protocolVersion,
        brokerVersion: status.brokerVersion
      }));
    } catch (error) {
      output({ ok: false, code: error.code || 'SUPERVISOR_UNAVAILABLE', error: error.message }, 1);
    }
    return;
  }
  if (command === 'submit') {
    const jobId = args[1];
    const ensured = await ensureResident();
    if (!ensured.ready) {
      output({ ok: false, code: ensured.code, reason: ensured.reason }, 1);
      return;
    }
    const response = await requestResident('submit', { jobId });
    output(response, response.ok && response.accepted ? 0 : 1);
    return;
  }
  output({ ok: false, code: 'INVALID_REQUEST', error: `unknown command: ${command}` }, 2);
}

main().catch((error) => {
  output({ ok: false, code: error.code || 'SUPERVISOR_ERROR', error: error.message }, 1);
});
