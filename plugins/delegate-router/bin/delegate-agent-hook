#!/usr/bin/env node
import fs from 'node:fs';
import path from 'node:path';
import { spawn } from 'node:child_process';
import { fileURLToPath } from 'node:url';
import {
  agentResultStatus,
  completeClaudeSubagentByAgentId,
  completeClaudeAgentStub,
  coordinatorSidecarDirectory,
  correlateClaudeSubagentStart,
  createClaudeAgentStub,
  deriveAgentId,
  deriveAgentTranscriptPath
} from './lib/agent-stubs.mjs';

const MAX_INPUT_BYTES = 256 * 1024;
const supervisorExecutable = path.join(path.dirname(fileURLToPath(import.meta.url)), 'delegate-supervisor');
let warned = false;

function warnOnce(error) {
  if (warned) return;
  warned = true;
  const message = String(error?.message || error).replace(/[\r\n]+/g, ' ').slice(0, 500);
  process.stderr.write(`delegate-agent-hook: stub journaling unavailable; Agent call continues: ${message}\n`);
}

function readInput() {
  const chunks = [];
  let used = 0;
  for (;;) {
    const buffer = Buffer.allocUnsafe(Math.min(8192, MAX_INPUT_BYTES + 1 - used));
    const count = fs.readSync(0, buffer, 0, buffer.length, null);
    if (!count) break;
    used += count;
    if (used > MAX_INPUT_BYTES) throw new Error('hook payload exceeds 256 KiB');
    chunks.push(buffer.subarray(0, count));
  }
  return JSON.parse(Buffer.concat(chunks).toString('utf8'));
}

function ensureAgentTailSupervisor() {
  if (String(process.env.DELEGATE_AGENT_TAIL ?? '1') === '0') return;
  if (String(process.env.DELEGATE_SUPERVISOR ?? '1') === '0') return;
  const executable = process.env.DELEGATE_AGENT_SUPERVISOR_BIN || supervisorExecutable;
  const child = spawn(process.execPath, [executable, 'start', '--json'], {
    cwd: '/',
    detached: true,
    stdio: 'ignore',
    windowsHide: true,
    env: process.env
  });
  child.once('error', () => {});
  child.unref();
}

function handle(payload) {
  if (String(process.env.DELEGATE_AGENT_STUBS ?? '1') === '0') return;
  if (payload?.hook_event_name === 'SubagentStart') {
    const correlated = correlateClaudeSubagentStart({
      sessionId: payload.session_id,
      transcriptAgentId: payload.agent_id,
      agentType: payload.agent_type,
      cwd: payload.cwd,
      coordinatorSidecarDir: coordinatorSidecarDirectory(payload.transcript_path)
    });
    if (correlated) ensureAgentTailSupervisor();
    return;
  }
  if (payload?.hook_event_name === 'SubagentStop') {
    completeClaudeSubagentByAgentId({
      sessionId: payload.session_id,
      transcriptAgentId: payload.agent_id,
      agentType: payload.agent_type,
      coordinatorSidecarDir: coordinatorSidecarDirectory(payload.transcript_path),
      transcriptPath: payload.agent_transcript_path,
      resultText: payload.last_assistant_message,
      status: 'completed'
    });
    return;
  }
  if (!['Agent', 'Task'].includes(payload?.tool_name)) return;
  const toolUseId = payload.tool_use_id || payload.toolUseId;
  if (!toolUseId) throw new Error('hook payload is missing correlatable tool_use_id');
  const common = {
    sessionId: payload.session_id,
    toolUseId,
    cwd: payload.cwd,
    coordinatorSidecarDir: coordinatorSidecarDirectory(payload.transcript_path)
  };
  if (payload.hook_event_name === 'PreToolUse') {
    const input = payload.tool_input || {};
    createClaudeAgentStub({
      ...common,
      prompt: input.prompt,
      agentType: input.subagent_type || input.agent_type,
      agentName: input.name || input.description,
      model: input.model
    });
    return;
  }
  if (payload.hook_event_name === 'PostToolUse') {
    const result = payload.tool_response ?? payload.tool_result;
    const outcome = agentResultStatus(result);
    completeClaudeAgentStub({
      ...common,
      ...outcome,
      agentId: deriveAgentId(result),
      transcriptPath: deriveAgentTranscriptPath(payload.transcript_path, result)
    });
  }
}

try { handle(readInput()); }
catch (error) { warnOnce(error); }
process.exitCode = 0;
