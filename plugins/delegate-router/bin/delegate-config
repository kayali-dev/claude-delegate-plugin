#!/usr/bin/env node
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import { dataDir, enabledProviders, jobsDir, providerConfigPath, saveEnabledProviders } from './lib/state.mjs';

const args = process.argv.slice(2);
const command = args.shift() || 'show';
const STATUSLINE_REFRESH_SECONDS = 5;
const JOB_LINK_PATTERN = '\\b(?<job>(?:(?:codex|cursor)-[a-z0-9]+-[a-z0-9]{6}|claude-agent-[a-f0-9]{24}))\\b';

function claudeSettingsPath() {
  return process.env.DELEGATE_CLAUDE_SETTINGS || path.join(os.homedir(), '.claude', 'settings.json');
}

function statuslineStatePath() {
  return path.join(dataDir(), 'statusline.json');
}

function footerLinksStatePath() {
  return path.join(dataDir(), 'footer-links.json');
}

function wrapperPath() {
  return path.join(dataDir(), 'statusline-wrapper.sh');
}

function originalScriptPath() {
  return path.join(dataDir(), 'statusline-original.sh');
}

function readSettings(file) {
  try {
    return JSON.parse(fs.readFileSync(file, 'utf8'));
  } catch (error) {
    if (error.code === 'ENOENT') return {};
    throw new Error(`Cannot read ${file}: ${error.message}`);
  }
}

function writeSettings(file, settings) {
  fs.mkdirSync(path.dirname(file), { recursive: true });
  const temporary = `${file}.${process.pid}.tmp`;
  fs.writeFileSync(temporary, `${JSON.stringify(settings, null, 2)}\n`, { mode: 0o600 });
  fs.renameSync(temporary, file);
}

function captureCommand() {
  const userBin = process.env.DELEGATE_USER_BIN || path.join(os.homedir(), '.local', 'bin');
  return path.join(userBin, 'delegate-claude-usage');
}

function workStateCommand() {
  const userBin = process.env.DELEGATE_USER_BIN || path.join(os.homedir(), '.local', 'bin');
  return path.join(userBin, 'delegate-work-state');
}

function footerLinkEntry() {
  const requested = String(process.env.DELEGATE_NATIVE_FOOTER_SCHEME || 'vscode').trim().toLowerCase();
  const scheme = ['vscode', 'vscode-insiders', 'cursor'].includes(requested) ? requested : 'vscode';
  const directory = encodeURI(path.resolve(jobsDir()));
  return {
    type: 'regex',
    pattern: JOB_LINK_PATTERN,
    url: `${scheme}://file${directory}/{job}.json`,
    label: '{job}'
  };
}

function sameValue(left, right) {
  return JSON.stringify(left) === JSON.stringify(right);
}

function readOptionalJson(file) {
  try { return JSON.parse(fs.readFileSync(file, 'utf8')); } catch { return null; }
}

function footerLinksEnable() {
  const file = claudeSettingsPath();
  const settings = readSettings(file);
  const desired = footerLinkEntry();
  const current = Array.isArray(settings.footerLinksRegexes) ? [...settings.footerLinksRegexes] : [];
  const saved = readOptionalJson(footerLinksStatePath());
  const ownedIndex = saved?.entry ? current.findIndex((entry) => sameValue(entry, saved.entry)) : -1;
  const desiredIndex = current.findIndex((entry) => sameValue(entry, desired));
  if (desiredIndex >= 0) {
    return { status: 'already-enabled', settingsFile: file, entry: desired };
  }
  if (ownedIndex >= 0) current.splice(ownedIndex, 1, desired);
  else {
    const samePattern = current.find((entry) => entry?.type === 'regex' && entry?.pattern === JOB_LINK_PATTERN);
    if (samePattern) {
      return { status: 'existing-pattern-preserved', settingsFile: file, entry: samePattern };
    }
    current.push(desired);
  }
  settings.footerLinksRegexes = current;
  writeSettings(file, settings);
  fs.mkdirSync(dataDir(), { recursive: true, mode: 0o700 });
  fs.writeFileSync(footerLinksStatePath(), `${JSON.stringify({ version: 1, settingsFile: file, entry: desired }, null, 2)}\n`, { mode: 0o600 });
  return { status: ownedIndex >= 0 ? 'updated' : 'enabled', settingsFile: file, entry: desired };
}

function footerLinksDisable() {
  const saved = readOptionalJson(footerLinksStatePath());
  if (!saved?.entry) return { status: 'not-enabled', settingsFile: claudeSettingsPath() };
  const file = claudeSettingsPath();
  const settings = readSettings(file);
  const current = Array.isArray(settings.footerLinksRegexes) ? [...settings.footerLinksRegexes] : [];
  const next = current.filter((entry) => !sameValue(entry, saved.entry));
  if (next.length) settings.footerLinksRegexes = next;
  else delete settings.footerLinksRegexes;
  writeSettings(file, settings);
  try { fs.rmSync(footerLinksStatePath(), { force: true }); } catch {}
  return { status: 'disabled', settingsFile: file, removed: current.length - next.length };
}

function footerLinksShow() {
  const settings = readSettings(claudeSettingsPath());
  const saved = readOptionalJson(footerLinksStatePath());
  return {
    settingsFile: claudeSettingsPath(),
    entry: saved?.entry || null,
    enabled: Boolean(saved?.entry && (settings.footerLinksRegexes || []).some((entry) => sameValue(entry, saved.entry)))
  };
}

function writeWrapper(originalCommand) {
  const capture = captureCommand();
  const workState = workStateCommand();
  fs.mkdirSync(dataDir(), { recursive: true, mode: 0o700 });
  let body;
  if (originalCommand) {
    // The original command runs from its own script file: embedding an
    // arbitrary command string inside the wrapper could change its shell
    // semantics (trailing comments, backgrounding, braces).
    fs.writeFileSync(originalScriptPath(), `#!/usr/bin/env bash
# Original status-line command preserved by delegate-config statusline enable.
${originalCommand}
`, { mode: 0o700 });
    body = `#!/usr/bin/env bash
# Generated by delegate-router (delegate-config statusline enable).
# Forwards the official Claude Code status-line payload to delegate-claude-usage
# so provider routing sees Claude's windows. A compact Delegate Router chip is
# prepended when available, then the original status line runs with its original
# stdin and shell semantics. Remove with: delegate-config statusline disable
input=$(cat)
printf '%s' "$input" | "${capture}" --quiet >/dev/null 2>&1 || true
chip=$(printf '%s' "$input" | "${workState}" 2>/dev/null || true)
if [ -n "$chip" ]; then printf '%s · ' "$chip"; fi
printf '%s' "$input" | /bin/bash "${originalScriptPath()}"
`;
  } else {
    body = `#!/usr/bin/env bash
# Generated by delegate-router (delegate-config statusline enable).
# No prior status line was configured: capture official Claude usage and compose
# it with the compact Delegate Router work-state chip when available.
# Remove with: delegate-config statusline disable
input=$(cat)
usage=$(printf '%s' "$input" | "${capture}" 2>/dev/null || true)
chip=$(printf '%s' "$input" | "${workState}" 2>/dev/null || true)
if [ -n "$chip" ] && [ -n "$usage" ]; then printf '%s · %s\n' "$chip" "$usage"
elif [ -n "$chip" ]; then printf '%s\n' "$chip"
else printf '%s\n' "$usage"
fi
`;
  }
  fs.writeFileSync(wrapperPath(), body, { mode: 0o700 });
  try { fs.chmodSync(wrapperPath(), 0o700); } catch {}
  return wrapperPath();
}

function statuslineEnable() {
  const file = claudeSettingsPath();
  const settings = readSettings(file);
  const current = settings.statusLine || null;
  if (current?.command === wrapperPath()) {
    const saved = JSON.parse(fs.readFileSync(statuslineStatePath(), 'utf8'));
    writeWrapper(saved.original?.command || null);
    const refresh = Number(current.refreshInterval);
    settings.statusLine = {
      ...current,
      refreshInterval: Number.isFinite(refresh) && refresh >= 1
        ? Math.min(refresh, STATUSLINE_REFRESH_SECONDS)
        : STATUSLINE_REFRESH_SECONDS
    };
    writeSettings(file, settings);
    const footerLinks = String(process.env.DELEGATE_NATIVE_FOOTER_LINKS ?? '1') === '0'
      ? { status: 'opted-out' }
      : footerLinksEnable();
    return { status: 'already-enabled', settingsFile: file, wrapper: wrapperPath(), footerLinks };
  }
  if (current && current.type !== 'command') {
    throw new Error(`statusLine type '${current.type}' is not wrappable; integrate delegate-claude-usage manually`);
  }
  fs.mkdirSync(dataDir(), { recursive: true, mode: 0o700 });
  fs.writeFileSync(statuslineStatePath(), `${JSON.stringify({ version: 1, settingsFile: file, original: current }, null, 2)}\n`, { mode: 0o600 });
  const wrapper = writeWrapper(current?.command || null);
  const refresh = Number(current?.refreshInterval);
  settings.statusLine = {
    ...(current || { type: 'command' }),
    type: 'command',
    command: wrapper,
    refreshInterval: Number.isFinite(refresh) && refresh >= 1
      ? Math.min(refresh, STATUSLINE_REFRESH_SECONDS)
      : STATUSLINE_REFRESH_SECONDS
  };
  writeSettings(file, settings);
  const footerLinks = String(process.env.DELEGATE_NATIVE_FOOTER_LINKS ?? '1') === '0'
    ? { status: 'opted-out' }
    : footerLinksEnable();
  return { status: 'enabled', settingsFile: file, wrapper, wrappedExisting: Boolean(current), footerLinks };
}

function statuslineDisable() {
  const file = claudeSettingsPath();
  const settings = readSettings(file);
  let original = null;
  try { original = JSON.parse(fs.readFileSync(statuslineStatePath(), 'utf8')).original; } catch {}
  if (settings.statusLine?.command !== wrapperPath() && !original) {
    return { status: 'not-enabled', settingsFile: file };
  }
  if (original) settings.statusLine = original;
  else delete settings.statusLine;
  writeSettings(file, settings);
  const footerLinks = footerLinksDisable();
  try { fs.rmSync(wrapperPath(), { force: true }); } catch {}
  try { fs.rmSync(originalScriptPath(), { force: true }); } catch {}
  try { fs.rmSync(statuslineStatePath(), { force: true }); } catch {}
  return { status: 'disabled', settingsFile: file, restored: original || null, footerLinks };
}

function statuslineShow() {
  const settings = readSettings(claudeSettingsPath());
  return {
    settingsFile: claudeSettingsPath(),
    statusLine: settings.statusLine || null,
    captureEnabled: settings.statusLine?.command === wrapperPath(),
    footerLinks: footerLinksShow()
  };
}

try {
  if (command === 'show') {
    console.log(JSON.stringify({ configFile: providerConfigPath(), enabled: enabledProviders() }, null, 2));
  } else if (command === 'providers') {
    const mode = args[0];
    const providers = mode === 'both' ? ['codex', 'cursor'] : mode === 'codex' ? ['codex'] : mode === 'cursor' ? ['cursor'] : null;
    if (!providers) throw new Error('expected codex, cursor, or both');
    console.log(JSON.stringify({ configFile: providerConfigPath(), enabled: saveEnabledProviders(providers) }, null, 2));
  } else if (command === 'statusline') {
    const action = args[0] || 'show';
    if (action === 'enable') console.log(JSON.stringify(statuslineEnable(), null, 2));
    else if (action === 'disable') console.log(JSON.stringify(statuslineDisable(), null, 2));
    else if (action === 'show') console.log(JSON.stringify(statuslineShow(), null, 2));
    else throw new Error('expected statusline enable|disable|show');
  } else if (command === 'footer-links') {
    const action = args[0] || 'show';
    if (action === 'enable') console.log(JSON.stringify(footerLinksEnable(), null, 2));
    else if (action === 'disable') console.log(JSON.stringify(footerLinksDisable(), null, 2));
    else if (action === 'show') console.log(JSON.stringify(footerLinksShow(), null, 2));
    else throw new Error('expected footer-links enable|disable|show');
  } else {
    console.error('Usage: delegate-config show | providers <codex|cursor|both> | statusline <enable|disable|show> | footer-links <enable|disable|show>');
    process.exit(command === 'help' ? 0 : 2);
  }
} catch (error) {
  console.error(`delegate-config: ${error.message}`);
  process.exit(1);
}
