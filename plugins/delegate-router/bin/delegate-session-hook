#!/usr/bin/env node
import fs from 'node:fs';
import path from 'node:path';
import { buildCollisionWatchPlan, ensureCollisionWatchSignal } from './lib/collision.mjs';
import { writeSessionCorrelationMarker } from './lib/monitor-correlation.mjs';
import { NotificationHandoff } from './lib/notification-handoff.mjs';
import { monitorScope } from './lib/monitor-runtime.mjs';
import { notificationHealth } from './lib/notification-health.mjs';
import {
  buildNativeWorkState,
  nativeWorkOptions,
  renderNativeAdditionalContext,
  NATIVE_CONTEXT_MAX_BYTES
} from './lib/native-session.mjs';
import { dataDir, listJobs } from './lib/state.mjs';

const MAX_INPUT_BYTES = 64 * 1024;

function canonicalDirectory(value) {
  const resolved = path.resolve(String(value || process.cwd()));
  try {
    return (fs.realpathSync.native || fs.realpathSync)(resolved);
  } catch {
    return path.normalize(resolved);
  }
}

function readPayload() {
  const chunks = [];
  let used = 0;
  for (;;) {
    const buffer = Buffer.allocUnsafe(Math.min(8192, MAX_INPUT_BYTES + 1 - used));
    const count = fs.readSync(0, buffer, 0, buffer.length, null);
    if (!count) break;
    used += count;
    if (used > MAX_INPUT_BYTES) throw new Error('SessionStart payload exceeds 64 KiB');
    chunks.push(buffer.subarray(0, count));
  }
  return JSON.parse(Buffer.concat(chunks).toString('utf8'));
}

function warn(reason, event = 'SessionStart') {
  const safe = String(reason || 'unavailable').replace(/[^A-Za-z0-9_.:-]/g, '-').slice(0, 120);
  process.stderr.write(`delegate-session-hook: ${event} degraded (${safe}); ambient context/watch may be unavailable, pull paths unchanged\n`);
}

try {
  const payload = readPayload();
  const event = String(payload?.hook_event_name || '');
  if (event !== 'SessionStart') throw new Error('expected SessionStart payload');
  const payloadSessionId = String(payload.session_id || '').trim();
  const environmentSessionId = String(process.env.CLAUDE_CODE_SESSION_ID || '').trim();
  if (environmentSessionId && payloadSessionId !== environmentSessionId) {
    throw new Error('session-id-mismatch');
  }
  const projectDir = canonicalDirectory(process.env.CLAUDE_PROJECT_DIR || payload.cwd || process.cwd());
  // Correlation is the only SessionStart work that determines which session
  // receives future pushes. Persist it before inventory/context work so a
  // slow or timed-out optional projection cannot strand the monitor in the
  // much noisier workspace fallback.
  const marker = writeSessionCorrelationMarker({
    stateDirectory: dataDir(),
    sessionId: payloadSessionId,
    coordinatorPid: process.ppid,
    projectDir,
    workspaceId: projectDir
  });
  if (!marker.ok) warn(marker.reason, event);
  // An independent hook records deliberate native opt-outs even if the Mod
  // cannot load. Recovery must not silently undo /config choices.
  try {
    if (/^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$/.test(payloadSessionId)) {
      new NotificationHandoff({ sessionId: payloadSessionId, projectDir, scope: monitorScope() })
        .setDeliveryEnabled(process.env.CLAUDE_PLUGIN_OPTION_NATIVE_ENABLED !== 'false'
          && process.env.CLAUDE_PLUGIN_OPTION_NATIVE_NOTIFICATIONS !== 'false');
    }
  } catch { warn('notification-config-unavailable', event); }
  const contextEnabled = String(process.env.DELEGATE_NATIVE_CONTEXT ?? '1') !== '0';
  const jobs = listJobs();
  let context = null;
  if (contextEnabled) {
    try {
      const delivery = notificationHealth({ sessionId: payloadSessionId, projectDir, scope: monitorScope() }, { jobs });
      const recovery = 'Delegate notification mode: ' + delivery.mode + '. During live supervision check delegate_notification_health using current sessionId '
        + JSON.stringify(payloadSessionId) + '. If needsFallback is true, invoke delegate-router:monitor-fallback yourself; never override explicit opt-outs. In legacy-persistent mode invoke delegate-router:legacy-monitor once if not already armed. No startup monitor in native mode.';
      context = renderNativeAdditionalContext({
        maxBytes: NATIVE_CONTEXT_MAX_BYTES - Buffer.byteLength(recovery, 'utf8') - 1,
        workState: buildNativeWorkState({
          jobs,
          ...nativeWorkOptions(payload, process.env)
        })
      });
      context = (context || '') + '\n' + recovery;
    } catch (error) {
      warn(`context-${error?.code || error?.name || 'unavailable'}`, event);
    }
  }

  const plan = buildCollisionWatchPlan({
    jobs,
    env: process.env,
    sessionId: payloadSessionId,
    workspaceId: projectDir,
    projectDir
  });
  try {
    ensureCollisionWatchSignal();
  } catch {
    const { recordCollisionWatchDegradation } = await import('./lib/control.mjs');
    recordCollisionWatchDegradation(plan.jobIds, {
      reason: 'watch-refresh-signal-unavailable',
      cap: plan.cap,
      totalPathCount: plan.totalPathCount,
      watchedPathCount: plan.watchedPathCount
    });
  }
  if (plan.degraded) {
    const { recordCollisionWatchDegradation } = await import('./lib/control.mjs');
    recordCollisionWatchDegradation(plan.omittedJobIds, {
      reason: plan.reason,
      cap: plan.cap,
      totalPathCount: plan.totalPathCount,
      watchedPathCount: plan.watchedPathCount
    });
  }
  process.stdout.write(`${JSON.stringify({
    hookSpecificOutput: {
      hookEventName: event,
      watchPaths: plan.watchPaths,
      ...(context ? { additionalContext: context } : {})
    }
  })}\n`);
} catch (error) {
  warn(error?.code || error?.message || error?.name, 'hook');
}

process.exitCode = 0;
